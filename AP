local function measureRootH(hum, root)
	if hum.FloorMaterial ~= Enum.Material.Air then
		local r = raycast(root.Position, V3(0, -10, 0))
		if r and r.Normal.Y > 0.97 then
			local d = root.Position.Y - r.Position.Y
			if d > 1 and d < 8 then rootHCache = d end
		end
	end
	if not rootHCache then
		rootHCache = root.Size.Y / 2 + hum.HipHeight + (hum.RigType == Enum.HumanoidRigType.R6 and 2 or 0)
	end
	return rootHCache
end

local function readStats(hum, root)
	local g = Workspace.Gravity
	local vy = hum.UseJumpPower and hum.JumpPower or math.sqrt(2 * g * hum.JumpHeight)
	S.vyNom = vy
	local jkey = hum.UseJumpPower and ("p" .. hum.JumpPower) or ("h" .. hum.JumpHeight)
	if S.calKey == jkey and S.vyCal then vy = S.vyCal end -- measured takeoff speed beats the nominal formula
	S.g = g
	S.vyReal = vy
	S.vy = vy * CONFIG.HeightSafety
	S.speed = hum.WalkSpeed
	S.rootH = measureRootH(hum, root)
	S.maxH = S.vy * S.vy / (2 * g)
	-- LEDGE LIFT: limbs don't collide, so the collision body bottom (root part / torso) sits rootH - rootHalf above
	-- the feet. A ledge only has to be cleared by THAT, not by the feet.
	S.rootHalf = root.Size.Y / 2
	S.liftBase = math.clamp(S.rootH - S.rootHalf, 0, 2.6) * CONFIG.LiftFactor
	S.lift = math.max(0, S.liftBase - (S.liftPenalty or 0))
	-- JUMP EXTENDER: the floor sensor fires from the root part's centre and its bottom corners, so we stay grounded until
	-- the whole root part is over the edge. Turned sideways its long side (halfW each way) lies along the jump.
	S.halfW, S.halfD = root.Size.X / 2, root.Size.Z / 2
	S.extend = 0
	if CONFIG.JumpExtender and CONFIG.FakeShiftlock then
		S.extend = math.clamp(S.extLearn or (S.halfW * CONFIG.ExtendFactor), 0, S.halfW)
	end
	-- measured hitbox (lateral / front-back half sizes incl. arms + accessories)
	local okb, ext = pcall(function() return hum.Parent:GetExtentsSize() end)
	if okb and ext then
		S.bodyL = math.clamp(ext.X / 2 + 0.1, 0.9, 2.4)
		S.bodyF = math.clamp(ext.Z / 2 + 0.1, 0.5, 1.3)
		S.headUp = math.clamp(ext.Y - S.rootH, 1.8, 3.4) -- root centre -> top of head / hair
	end
end

-- time to come back down to (takeoff height + dh)
local function flightTime(dh)
	local disc = S.vy * S.vy - 2 * S.g * dh
	if disc < 0 then return nil end
	return (S.vy + math.sqrt(disc)) / S.g
end

-- total air time when we leave the ledge and jump `tau` seconds LATE: we fall for tau first (keeping our
-- horizontal speed), then jump from the lower height. A short delay buys extra horizontal distance.
local function lateTime(dh, tau)
	local disc = S.vy * S.vy - 2 * S.g * (dh + 0.5 * S.g * tau * tau)
	if disc < 0 then return nil end
	return tau + (S.vy + math.sqrt(disc)) / S.g
end

-- smallest delay tau (0 = ordinary jump) for which WalkSpeed * airtime covers `need` studs. nil = can't.
local function fitReach(dh, need, allowLate)
	local tau = 0
	local maxTau = allowLate and CONFIG.MaxLateJump or 0
	while tau <= maxTau + 1e-6 do
		local tt = lateTime(dh, tau)
		if tt and need <= S.speed * tt * CONFIG.ReachSafety - 0.2 then return tt, tau end
		tau += 0.03
	end
	return nil
end

local function checkYield()
	if os.clock() - sliceStart > CONFIG.TimeSlice then
		task.wait()
		sliceStart = os.clock()
		if currentToken ~= searchId then error(CANCEL, 0) end
	end
end

---------------------------------------------------------------- hazards (kill bricks)
-- There is no universal "kill brick" flag, so every part gets a score from many weak signals, and the
-- score is then CORRECTED by what actually happens (corrections beat guessing):
--   names (part + parents), tags, attributes, child scripts     strong words +3, weak words +1.6
--   TouchInterest +1, Fire child +1, red/orange colour +1.6, Neon +1, repeated thin touch bars +0.8,
--   touch-enabled but NON-collidable (kill zone / laser) +1.5
--   CanTouch = false  -2 (can't fire Touched, so it can't be a touch-kill)
--   "safe / checkpoint / spawn / heal / deco" names always win
-- Corrections:
--   you die / get hurt right after touching something new = that part is blamed
--   other players dying / getting hurt where they just arrived = blamed (needs 2 deaths)
--   the same colour + material blamed twice = that look is deadly
--   a "hazard" you stand on / touch for 3 s without taking damage = false alarm, cleared automatically
-- Everything is automatic: no marking, no setup. Detected hazards get a red outline (ShowHazards).

