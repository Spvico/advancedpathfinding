connect(player.CharacterAdded, function(char)
	rootHCache = nil
	stop()
	refreshFilter()
	task.spawn(setupLearning, char)
end)

local function destroy()
	alive = false
	do local _, h1 = getChar(); faceRelease(h1) end
	for _, c in ipairs(otherConns) do pcall(function() c:Disconnect() end) end
	active = false
	searchId += 1
	follow = nil
	pcall(function() RunService:UnbindFromRenderStep(BIND) end)
	for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
	for _, c in ipairs(charConns) do pcall(function() c:Disconnect() end) end
	gui:Destroy()
	visuals:Destroy()
	hazardMarks:Destroy()
	env.__AdvancedPathfinder = nil
end
