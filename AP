end

-- ---- red outline on detected hazards
local hazardMarks = Instance.new("Folder")
hazardMarks.Name = "AP_Hazards"
hazardMarks.Parent = Workspace.Terrain
local marks, markCount = {}, 0
local function setMark(part, on)
	if not CONFIG.ShowHazards then return end
	local m = marks[part]
	if on and not m and markCount < 80 then
		local box = Instance.new("SelectionBox")
		box.Adornee = part
		box.Color3 = Color3.fromRGB(255, 70, 70)
		box.LineThickness = 0.04
		box.SurfaceColor3 = Color3.fromRGB(255, 70, 70)
		box.SurfaceTransparency = 0.8
		box.Parent = hazardMarks
		marks[part] = box
		markCount += 1
	elseif not on and m then
		m:Destroy()
		marks[part] = nil
		markCount -= 1
	end
end

local function textScore(str)
	str = string.lower(str)
	if string.find(str, "unsafe", 1, true) then return 3 end
	for _, w in ipairs(SAFE_WORDS) do
		if string.find(str, w, 1, true) then return -4 end
	end
	for _, w in ipairs(HAZ_STRONG) do
		if string.find(str, w, 1, true) then return 3 end
	end
	for _, w in ipairs(HAZ_WEAK) do
		if string.find(str, w, 1, true) then return 1.6 end
	end
	return 0
end

local function signature(part) -- colour + material (generalises to "all parts that look like this")
	local c = part.Color
	if math.max(c.R, c.G, c.B) - math.min(c.R, c.G, c.B) < 0.25 then return nil end -- grey/white: too generic
	return string.format("%d,%d,%d,%s", math.floor(c.R * 255), math.floor(c.G * 255), math.floor(c.B * 255), part.Material.Name)
end

local function sigKey(part) -- name + size + colour + material (identifies "this kind of part" across servers)
	local c, sz = part.Color, part.Size
	return string.format("%s|%.1f,%.1f,%.1f|%d,%d,%d|%s", part.Name, sz.X, sz.Y, sz.Z,
		math.floor(c.R * 255), math.floor(c.G * 255), math.floor(c.B * 255), part.Material.Name)
end

local function computeHazard(part)
	local m = manual[part]
	if m ~= nil then return m end
	local key = sigKey(part)
	if saved.safe[key] then return false end
	if saved.haz[key] then return true end
	if (learned[part] or 0) >= 2 then return true end
	local sig = signature(part)
	if sig and (sigHaz[sig] or 0) >= 2 then return true end
	local pts = 0

	local inst, depth = part, 0
	while inst and inst ~= Workspace and depth < 4 do
		local sc = textScore(inst.Name)
		if sc < 0 then return false end
		if sc > 0 then
			pts += sc
			break
		end
		inst, depth = inst.Parent, depth + 1
	end
	for _, tag in ipairs(CollectionService:GetTags(part)) do
		local sc = textScore(tag)
		if sc > 0 then pts += sc break end
	end
	for k, v in pairs(part:GetAttributes()) do
		if textScore(k) > 0 and (v == true or (type(v) == "number" and v > 0)) then pts += 3 break end
	end
	local hasTouch = false
	for _, c in ipairs(part:GetChildren()) do
		local cn = c.ClassName
		if cn == "TouchTransmitter" then
			hasTouch = true
			pts += 1
		elseif cn == "Fire" then
			pts += 1
		elseif cn ~= "Decal" and cn ~= "Texture" then
			local sc = textScore(c.Name)
			if sc > 0 then pts += sc end
		end
	end
	if not part.CanTouch then pts -= 2 end

	-- a row of identical thin touch-enabled bars across a path is the classic obstacle layout
	local sz = part.Size
	if hasTouch and math.min(sz.X, sz.Y, sz.Z) <= 2.5 and part.Parent and part.Parent ~= Workspace then
		local same = 0
		for _, sib in ipairs(part.Parent:GetChildren()) do
			if sib ~= part and sib:IsA("BasePart") and sib.Material == part.Material and sib.Color == part.Color
				and (sib.Size - sz).Magnitude < 0.3 then
				same += 1
				if same >= 2 then break end
			end
		end
		if same >= 2 then pts += 0.8 end
	end

	local col = part.Color
	if col.R >= 0.65 and col.G <= 0.45 and col.B <= 0.25 and col.R - col.G >= 0.3 then pts += 1.6 end
	-- materials games use for danger: weak alone, they add up with the other signals
	if part.Material == Enum.Material.Neon then pts += 1.0 end
	if part.Material == Enum.Material.CrackedLava then pts += 1.0 end
	return pts >= CONFIG.HazardThreshold
end

local function hazardPart(part)
	if not CONFIG.AvoidHazards or not part then return false end
	local c = hazardCache[part]
	if c == nil then
		local ok, res = pcall(computeHazard, part)
		c = ok and res or false
		hazardCache[part] = c
		if c then setMark(part, true) end
	end
	return c
end

local function isHazardHit(res)
	if not CONFIG.AvoidHazards or not res or not res.Instance then return false end
	if res.Instance:IsA("Terrain") then return res.Material == Enum.Material.CrackedLava end
	return hazardPart(res.Instance)
end

local function hazardBox(cf, size)
	if not CONFIG.AvoidHazards then return false end
	for _, p in ipairs(Workspace:GetPartBoundsInBox(cf, size, hazardOverlap)) do
		if p.ClassName ~= "Terrain" and hazardPart(p) then
			lastHazardPart = p
			return true
		end
	end
	return false
end

local function cellKey(p)
	return (math.floor(p.X / 1.5 + 0.5) * 100003 + math.floor(p.Z / 1.5 + 0.5)) * 4001 + math.floor(p.Y / 2 + 0.5)
end

-- would a character standing at `pos` be touching something deadly (even a non-collidable zone)?
local function hazardAtBody(pos)
	if not CONFIG.AvoidHazards then return false end
	local k = cellKey(pos)
	local t = tempBlocked[k]
	if t then
		if t > os.clock() then return true end
		tempBlocked[k] = nil
	end
	local c = bodyCache[k]
	if c == nil then
		c = hazardBox(CFrame.new(pos.X, pos.Y + 2.9, pos.Z), V3(2.3, 5.4, 2.3))
		bodyCache[k] = c
	end
	return c
end

---------------------------------------------------------------- slippery surfaces
-- friction = the part's CustomPhysicalProperties, else the material default (Ice 0.02, Glacier 0.05, ...)
local matCache = {}
local function matFriction(mat)
	local f = matCache[mat]
	if f == nil then
		local ok, pp = pcall(PhysicalProperties.new, mat)
		f = ok and pp.Friction or 0.3
		matCache[mat] = f
	end
	return f
end

local frictionCache = setmetatable({}, { __mode = "k" })
local function frictionOfPart(part)
	local f = frictionCache[part]
	if f == nil then
		local cp = part.CustomPhysicalProperties
		f = cp and cp.Friction or matFriction(part.Material)
		frictionCache[part] = f
	end
	return f
end

local function isSlipperyPart(part)
	return CONFIG.IceSupport and part ~= nil and frictionOfPart(part) < CONFIG.SlipperyFriction
end

local function isSlipperyHit(res)
	if not CONFIG.IceSupport or not res or not res.Instance then return false end
	if res.Instance:IsA("Terrain") then return matFriction(res.Material) < CONFIG.SlipperyFriction end
	return frictionOfPart(res.Instance) < CONFIG.SlipperyFriction
end

-- on ice, nodes near an edge are expensive: the path hugs the middle of the platform
local function slipEdgePenalty(b)
	local m = CONFIG.SlipEdgeMargin
	local miss = 0
	for _, o in ipairs({ { m, 0 }, { -m, 0 }, { 0, m }, { 0, -m } }) do
		local r = raycast(V3(b.X + o[1], b.Y + 1.2, b.Z + o[2]), V3(0, -2.6, 0))
		if not r or r.Normal.Y < COS_SLOPE then miss += 1 end
	end
	return miss * CONFIG.SlipEdgePenalty
end

---------------------------------------------------------------- jump edges
-- finds the point where we should leave the ground when heading to `dir`
local function findTakeoff(P, dir, maxLen)
	local wall = sweep(P + V3(0, MID_H, 0), dir * maxLen, RADIUS)
	local limit = wall and math.max(0, wall.Distance - 0.05) or maxLen
	local lastP = P
	local k = 1
	while k * 0.5 <= limit do
		local p = P + dir * (k * 0.5)
		local r = raycast(V3(p.X, lastP.Y + 1.2, p.Z), V3(0, -2.6, 0))
		if r and r.Normal.Y >= COS_SLOPE and not isHazardHit(r) then
			lastP = r.Position
		else
			local inset = CONFIG.TakeoffInset
			if r and isHazardHit(r) then inset = CONFIG.HazardClearance end -- ledge is a hazard: keep body clear of it
			local T = lastP - dir * inset
			if (T - P):Dot(dir) < 0 then T = P end
			-- still within body reach of something deadly (non-collidable zone, spikes)? back off more
			local tries = 0
			while tries < 4 and (T - P):Dot(dir) > 0.4 and hazardAtBody(T) do
				T = T - dir * 0.5
				tries += 1
			end
			return T
		end
		k += 1
	end
	if wall then return lastP end -- jumping UP onto something: stand-off at the wall
	return nil                    -- floor continues, no ledge here
end

-- body-sized sweeps along the predicted arc
local function arcClear(T, L, t, legs, steps)
	local N = steps or 5
	local lip = (L.Y - T.Y > CONFIG.StepUp) and L.Y or nil
	local prev
	for i = 0, N do
		local s = i / N
		local tt = t * s
		local p = V3(
			T.X + (L.X - T.X) * s,
			T.Y + S.rootH + S.vy * tt - 0.5 * S.g * tt * tt,
			T.Z + (L.Z - T.Z) * s
		)
		if i >= 1 and i < N and hazardBox(CFrame.new(p), V3(2.2, 4.8, 2.2)) then return false end
		if prev and (not lip or (prev.Y - S.rootH) >= lip - 0.5) then
			local d = p - prev
			if sweep(prev, d, RADIUS) or raycast(prev + V3(0, 2, 0), d)
				or (legs and sweep(prev + V3(0, -1.8, 0), d, 0.8)) then return false end
		end
		prev = p
	end
	return true
end

local LERPS = { 0, 0.3, 0.6, 1 }
local faceCache = {}
local climbChecks = 0

-- Top walkable face of a part. Works for blocks in ANY orientation, and for cylinders
-- (a Roblox cylinder's round face is on its local X axis, so a flat disk is "rotated").
local function topFace(part)
	local cached = faceCache[part]
	if cached ~= nil then return cached or nil end
	local face = false
	local skip = (part.ClassName == "Part" and part.Shape == Enum.PartType.Ball)
		or part:IsA("WedgePart") or part:IsA("CornerWedgePart") or part:IsA("TrussPart")
	if not skip then
		local cf, size = part.CFrame, part.Size
		local axes = { cf.RightVector, cf.UpVector, cf.LookVector }
		local sz = { size.X, size.Y, size.Z }
		local isCyl = part.ClassName == "Part" and part.Shape == Enum.PartType.Cylinder
		local best, bestArea = nil, -1
		for i = 1, 3 do
			if not isCyl or i == 1 then
				if math.abs(axes[i].Y) >= COS_LAND then
					local area = sz[i % 3 + 1] * sz[(i + 1) % 3 + 1]
					if area > bestArea then best, bestArea = i, area end
				end
			end
		end
		if best then
			local sign = axes[best].Y >= 0 and 1 or -1
			local j, k = best % 3 + 1, (best + 1) % 3 + 1
			face = {
				center = cf.Position + axes[best] * (sign * sz[best] / 2),
				u = axes[j], v = axes[k], hu = sz[j] / 2, hv = sz[k] / 2,
				thick = sz[best], circle = isCyl, r = math.min(size.Y, size.Z) / 2,
			}
		end
	end
	faceCache[part] = face
	return face or nil
end

-- closest point on the face to P, pulled LandMargin inside the edge (circle-aware)
local function nearestOnFace(face, P, margin)
	margin = margin or CONFIG.LandMargin
	local d = P - face.center
	local du, dv = d:Dot(face.u), d:Dot(face.v)
	if face.circle then
		local maxR = math.max(0, face.r - margin)
		local len = math.sqrt(du * du + dv * dv)
		if len > maxR and len > 1e-4 then du, dv = du / len * maxR, dv / len * maxR end
	else
		local mu = math.max(0, face.hu - margin)
		local mv = math.max(0, face.hv - margin)
		du, dv = math.clamp(du, -mu, mu), math.clamp(dv, -mv, mv)
	end
	return face.center + face.u * du + face.v * dv
end

-- real surface under the bounding-box point (handles wavy / bumpy tops); falls back toward the center
local function snapLanding(face, pt)
	local win = math.min(face.thick, 6)
	for _, f in ipairs(LERPS) do
		local q = pt:Lerp(face.center, f)
		local r = raycast(V3(q.X, q.Y + 1.5, q.Z), V3(0, -(1.5 + win), 0))
		if r and r.Normal.Y >= COS_LAND and r.Position.Y <= q.Y + 0.6 and not isHazardHit(r) then return r end
	end
	return nil
end

local function arcRel(tt) return S.vy * tt - 0.5 * S.g * tt * tt end -- height above takeoff ground after tt seconds

local FAN = { 0, 0.4, -0.4, 0.8, -0.8 } -- takeoff search directions around the straight line to the landing (rad)

local function buildJump(node, face, pt, m)
	local P = node.pos
	local r = snapLanding(face, pt)
	if not r then return nil end
	local L = r.Position
	if hazardAtBody(L) then return nil end
	local fv = V3(L.X - P.X, 0, L.Z - P.Z)
	local fd = fv.Magnitude
	if fd < 0.2 then return nil end
	local dir = fv / fd
	local mEff = math.min(m or CONFIG.LandMargin, face.circle and face.r or math.min(face.hu, face.hv))

	-- the straight line P -> L can run into a wall or miss the ledge: try a fan of takeoff directions
	for _, ang in ipairs(FAN) do
		local c, sn = math.cos(ang), math.sin(ang)
		local dd = V3(dir.X * c - dir.Z * sn, 0, dir.X * sn + dir.Z * c)
		local T = findTakeoff(P, dd, math.min(fd + 2, CONFIG.EdgeScan))
		if T then
			local dh = L.Y - T.Y
			local t = flightTime(dh)
			if t then
				local hd = flatDist(L, T)
				if hd >= 0.3 and hd <= S.speed * t * CONFIG.ReachSafety - 0.2 then
					local ok = true
					if dh > CONFIG.StepUp then
						-- going UP: our feet must be above the landing's lip when the body reaches its edge
						local u = hd / t
						ok = arcRel(math.max(0, hd - mEff - 0.5) / u) >= dh + 0.1
					end
					if ok and arcClear(T, L, t) then
						return {
							kind = "jump", pos = L, inst = r.Instance, takeoff = T,
							cost = flatDist(P, T) + hd + CONFIG.JumpPenalty + (isSlipperyHit(r) and CONFIG.SlipPenalty or 0),
						}
					end
				end
			end
		end
	end
	return nil
end

local function expandJumps(node, out, climbOnly)
	if S.vyReal < 10 or S.speed < 1 then return end
	if jumpExpansions >= CONFIG.MaxJumpExpansions then return end
	jumpExpansions += 1
	local P = node.pos
	local maxFall = math.max(0, math.min(CONFIG.MaxFall, P.Y - (Workspace.FallenPartsDestroyHeight + 15)))
	local tMax = flightTime(-maxFall)
	if not tMax then return end
	local radius = math.min(S.speed * tMax + CONFIG.EdgeScan, CONFIG.MaxQueryRadius)
	local parts = Workspace:GetPartBoundsInRadius(P, radius, overlapParams)
	local cands = {}
	for _, part in ipairs(parts) do
		if part ~= node.inst and part.ClassName ~= "Terrain" then
			local face = topFace(part)
			if face and not hazardPart(part) and not (CONFIG.ForbidSlippery and isSlipperyPart(part)) then
				local pt = nearestOnFace(face, P)
				local dh = pt.Y - P.Y
				local fd = flatDist(pt, P)
				if dh <= S.maxH - 0.3 and dh >= -maxFall and (fd > 2.2 or dh > CONFIG.StepUp)
					and (not climbOnly or dh > CONFIG.StepUp) then
					local t = flightTime(dh)
					if t and fd - CONFIG.EdgeScan <= S.speed * t * CONFIG.ReachSafety then
						local skip = false
						if math.abs(dh) <= CONFIG.StepUp then
							-- same level and floor continuous between us = walkable, no jump needed
							local mid = (P + pt) / 2
							if raycast(V3(mid.X, P.Y + 1.2, mid.Z), V3(0, -2.4, 0)) then skip = true end
						end
						if not skip then
							cands[#cands + 1] = { pt = pt, pt2 = nearestOnFace(face, P, 0.7), face = face, score = heur(pt, goalPos) + fd * 0.25 }
						end
					end
				end
			end
		end
	end
	table.sort(cands, function(a, b) return a.score < b.score end)
	for i = 1, math.min(#cands, CONFIG.MaxJumpCandidates) do
		local e = buildJump(node, cands[i].face, cands[i].pt, CONFIG.LandMargin)
		if not e then e = buildJump(node, cands[i].face, cands[i].pt2, 0.7) end
		if e then out[#out + 1] = e end
		checkYield()
	end
end

-- truss / ladder edges: climb up to a ledge near the top, or down to the ground near the bottom
local function expandClimbs(node, out)
	if climbChecks >= CONFIG.MaxClimbChecks then return end
	climbChecks += 1
	local P = node.pos
	local parts = Workspace:GetPartBoundsInRadius(P, 5, overlapParams)
	for _, part in ipairs(parts) do
		if part.ClassName == "TrussPart" then
			local cf, size = part.CFrame, part.Size
			if math.abs(cf.UpVector.Y) >= 0.8 then
				local ext = 0.5 * (size.Y * math.abs(cf.UpVector.Y)
					+ size.X * math.abs(cf.RightVector.Y) + size.Z * math.abs(cf.LookVector.Y))
				local c = cf.Position
				local topY, botY = c.Y + ext, c.Y - ext
				local hw = math.max(size.X, size.Z) * 0.5
				if flatDist(P, c) - hw <= 3.2 then
					for _, up in ipairs({ true, false }) do
						local can = (up and (P.Y <= botY + 4 and topY - P.Y >= 3))
							or (not up and (P.Y >= topY - 4 and P.Y - botY >= 3))
						if can then
							local best
							for a = 0, 7 do
								local ang = a * math.pi / 4
								local x, z = c.X + math.cos(ang) * (hw + 2), c.Z + math.sin(ang) * (hw + 2)
								local r = raycast(V3(x, up and (topY + 2.5) or (botY + 4), z), V3(0, -7, 0))
								if r and r.Instance ~= part and r.Normal.Y >= COS_LAND and not isHazardHit(r) then
									local ey = r.Position.Y
									local ok = (up and (ey >= P.Y + 3 and ey <= topY + 1.2))
										or (not up and (ey <= P.Y - 3 and ey >= botY - 3))
									if ok then
										local sc = (r.Position - goalPos).Magnitude
										if not best or sc < best.sc then best = { r = r, sc = sc } end
									end
								end
							end
							if best then
								local E = best.r.Position
								out[#out + 1] = {
									kind = "climb", pos = E, inst = best.r.Instance, truss = part,
									topY = topY, botY = botY, up = up, from = P,
									cost = math.abs(E.Y - P.Y) * 0.8 + flatDist(P, E) + 3,
								}
							end
						end
					end
				end
			end
		end
	end
end

-- Falls onto ANY ground (terrain included). For every direction we sample the ground below at growing
-- distances from the ledge; each sample's own depth gives its own air time, so the horizontal reach is
-- counted per sample:   t = (vy + sqrt(vy^2 + 2*g*depth)) / g,   reach = WalkSpeed * t.   Deeper = farther.
local FALL_DIRS = 8
local FALL_RADII = { 2.5, 4, 6, 9, 13, 18, 25, 35, 50, 70, 100 }

local function expandFalls(node, out)
	if S.vyReal < 10 or S.speed < 1 then return end
	if fallExpansions >= CONFIG.MaxFallExpansions then return end
	fallExpansions += 1
	local P = node.pos
	local voidY = Workspace.FallenPartsDestroyHeight + 15
	local found = {}
	for k = 0, FALL_DIRS - 1 do
		local ang = k * (2 * math.pi / FALL_DIRS)
		local dir = V3(math.cos(ang), 0, math.sin(ang))
		local T = findTakeoff(P, dir, CONFIG.EdgeScan)
		if T then
			local depthMax = math.min(CONFIG.MaxFall, T.Y - voidY)
			local best
			if depthMax > 1 then
				for _, r in ipairs(FALL_RADII) do
					local q = T + dir * r
					local hit = raycast(V3(q.X, T.Y + 2, q.Z), V3(0, -(2 + depthMax), 0))
					if hit and hit.Normal.Y >= COS_LAND and not isHazardHit(hit) and hit.Position.Y < T.Y - 1
						and not (CONFIG.ForbidSlippery and isSlipperyHit(hit)) then
						local L = hit.Position
						local t = flightTime(L.Y - T.Y)
						if t and flatDist(L, T) <= S.speed * t * CONFIG.ReachSafety - 0.25 then
							local sc = heur(L, goalPos)
							if not best or sc < best.sc then best = { L = L, inst = hit.Instance, T = T, sc = sc, slip = isSlipperyHit(hit) } end
						end
					end
				end
			end
			if best then found[#found + 1] = best end
		end
		checkYield()
	end
	table.sort(found, function(a, b) return a.sc < b.sc end)
	for i = 1, math.min(#found, 3) do
		local c = found[i]
		local t = flightTime(c.L.Y - c.T.Y)
		if t and not hazardAtBody(c.L) and arcClear(c.T, c.L, t) then
			out[#out + 1] = {
				kind = "jump", pos = c.L, inst = c.inst, takeoff = c.T,
				cost = flatDist(P, c.T) + flatDist(c.L, c.T) + CONFIG.JumpPenalty + (c.slip and CONFIG.SlipPenalty or 0),
			}
		end
		checkYield()
	end
end

---------------------------------------------------------------- walk edges
local function pathClear(a, q, radius)
	local d = q - a
	if sweep(a + V3(0, MID_H, 0), d, radius) then return false end
	if raycast(a + V3(0, HEAD_H, 0), d) then return false end
	return true
end

local function rampOK(a, b)
	local mx, mz, my = (a.X + b.X) / 2, (a.Z + b.Z) / 2, (a.Y + b.Y) / 2
	local r = raycast(V3(mx, my + 1.2, mz), V3(0, -2.4, 0))
	return r ~= nil and r.Normal.Y >= COS_SLOPE and math.abs(r.Position.Y - my) < 0.7
end

-- Vault: a wall blocks the way (  _|_  ). Nothing about the wall is hardcoded: how thick / how tall it may be
-- comes from THIS player's JumpPower|JumpHeight, gravity and WalkSpeed.
--   air time      t   = (vy + sqrt(vy^2 - 2*g*dh)) / g          (dh = landing height - takeoff height)
--   reach         D   <= WalkSpeed * t * ReachSafety             -> the farthest landing we could ever make
--   max wall      height <= apex of the jump (vy^2 / 2g), thickness <= reach - run-up - landing offset
-- For every run-up distance b before the wall face we check the arc ANALYTICALLY (feet above the wall top
-- while we are horizontally over the wall), then confirm with body + leg sweeps.

-- farthest horizontal distance this player could ever land from P (deepest possible landing = the void)
local function reachLimit(P)
	local depth = math.max(0, math.min(CONFIG.MaxFall, P.Y - (Workspace.FallenPartsDestroyHeight + 15)))
	local t = flightTime(-depth)
	return t and S.speed * t * CONFIG.ReachSafety or 0
end

-- how far behind the takeoff point we start running: 1.4 normally, longer on ice (slow acceleration)
local function pickRunup(node, T, d)
	local ru = 1.4
	if node.inst and CONFIG.IceSupport and isSlipperyPart(node.inst) then
		ru = math.clamp(S.speed * S.speed / (2 * S.iceAccel) * 0.8, 1.4, 9)
	end
	if ru > 1.4 then
		local R0 = T - d * ru
		local rr = raycast(V3(R0.X, T.Y + 1.2, R0.Z), V3(0, -2.6, 0))
		if not (rr and rr.Normal.Y >= COS_SLOPE and not isHazardHit(rr)) then ru = 1.4 end
	end
	return ru
end

local function buildVault(node, d)
	local P = node.pos
	local wall = sweep(P + V3(0, MID_H, 0), d * 3.4, RADIUS)
	if not wall then return nil end
	local face = wall.Distance + RADIUS -- distance from P to the wall face
	-- anything at apex height in the way = wall taller than this player can ever clear
	if sweep(P + V3(0, S.maxH + 0.2, 0), d * (face + 1.5), 0.5) then return nil end

	local limit = reachLimit(P)
	local depth = math.max(0, math.min(CONFIG.MaxFall, P.Y - (Workspace.FallenPartsDestroyHeight + 15)))
	local top0 = P.Y + S.maxH + 1
	local down = S.maxH + 1 + depth

	-- walk the columns behind the face until the wall ends; the scan is bounded by REACH, not a constant
	local sFar, Hw = nil, P.Y
	local s = face + 0.25
	while s - face <= limit do
		local q = P + d * s
		local hit = raycast(V3(q.X, top0, q.Z), V3(0, -down, 0))
		if not hit then return nil end -- void beyond
		local y = hit.Position.Y
		if y > P.Y + CONFIG.StepUp then
			Hw = math.max(Hw, y)
		else
			if hit.Normal.Y >= COS_SLOPE and not isHazardHit(hit) then sFar = s end
			break
		end
		s += (s - face < 8) and 0.5 or 1.0
	end
	if not sFar then return nil end
	local thick = sFar - face

	-- landing a bit past the wall's far face
	local L, Linst
	for _, extra in ipairs({ 1.0, 0.5, 0 }) do
		local q = P + d * (sFar + extra)
		local hit = raycast(V3(q.X, top0, q.Z), V3(0, -down, 0))
		if hit and hit.Normal.Y >= COS_LAND and not isHazardHit(hit) and hit.Position.Y <= P.Y + CONFIG.StepUp
			and not hazardAtBody(hit.Position) then
			L, Linst = hit.Position, hit.Instance
			break
		end
	end
	if not L then return nil end

	-- run-up search: shortest run-up that clears the wall; stop as soon as the jump would be too long to reach
	local Hrel = Hw - P.Y
	local b = 1.2
	while true do
		local T0 = P + d * (face - b)
		local tr = raycast(V3(T0.X, P.Y + 1.2, T0.Z), V3(0, -2.6, 0))
		if not (tr and tr.Normal.Y >= COS_SLOPE and not isHazardHit(tr) and math.abs(tr.Position.Y - P.Y) < 1.2) then
			if b > face + 0.5 then break end -- ran out of floor behind us
		else
			local T = tr.Position
			local t = flightTime(L.Y - T.Y)
			if not t then break end
			local D = flatDist(L, T)
			if D > S.speed * t * CONFIG.ReachSafety - 0.25 then break end -- longer run-up = longer jump: impossible from here on
			local u = D / t -- horizontal speed we need along the arc
			local x0, x1 = math.max(0, b - 0.5), b + thick + 0.5
			if arcRel(x0 / u) >= Hrel + 0.3 and arcRel(x1 / u) >= Hrel + 0.3
				and not hazardAtBody(T)
				and (face - b >= 0 or pathClear(P, T, RADIUS))
				and arcClear(T, L, t, true, 8) then
				return {
					kind = "jump", vault = true, pos = L, inst = Linst, takeoff = T,
					cost = flatDist(P, T) + D + CONFIG.JumpPenalty + 2, runup = pickRunup(node, T, d),
				}
			end
		end
		b += 0.6
	end
	return nil
end

local function expandVaults(node, out, dirs)
	if S.vyReal < 10 or S.speed < 1 then return end
	local gd = flat(goalPos - node.pos)
	for _, d in ipairs(dirs) do
		if vaultExpansions >= CONFIG.MaxVaultExpansions then return end
		if gd.Magnitude < 1 or d:Dot(gd.Unit) > -0.05 then -- only walls between us and the goal
			vaultExpansions += 1
			local e = buildVault(node, d)
			if e then out[#out + 1] = e end
			checkYield()
		end
	end
end

-- Hop: a hazard strip (lava stripe, kill bar) lies across the floor. It is often the SAME part as the floor,
-- so part-based landing candidates never see the far side. Scan the line instead: find the strip, the first
-- safe ground behind it, take off a body-width before it and land a body-width after it.
local function buildHop(node, d)
	local P = node.pos
	local sNear, sFar
	local s = 0.25
	local limit = reachLimit(P) -- widest strip is whatever this player's jump can span
	while s <= limit do
		local q = P + d * s
		local hit = raycast(V3(q.X, P.Y + 2.2, q.Z), V3(0, -5.5, 0))
		if hit and isHazardHit(hit) then
			sNear = sNear or s
		elseif sNear then
			if hit and hit.Normal.Y >= COS_SLOPE and math.abs(hit.Position.Y - P.Y) <= CONFIG.StepUp then sFar = s end
			break
		elseif not hit then
			return nil -- void before any hazard: that's a gap, not a strip
		end
		if not sNear and s > 4.5 then return nil end -- the hazard that rejected this step is within a step or two
		s += 0.4
	end
	if not sNear or not sFar then return nil end

	local L, Linst
	for _, extra in ipairs({ 1.0, 1.6, 2.4 }) do
		local q = P + d * (sFar + extra)
		local hit = raycast(V3(q.X, P.Y + 2.2, q.Z), V3(0, -5.5, 0))
		if hit and hit.Normal.Y >= COS_LAND and not isHazardHit(hit) and math.abs(hit.Position.Y - P.Y) <= CONFIG.StepUp
			and not hazardAtBody(hit.Position) then
			L, Linst = hit.Position, hit.Instance
			break
		end
	end
	if not L then return nil end

	local T = P
	local T0 = P + d * (sNear - CONFIG.HazardClearance)
	local tr = raycast(V3(T0.X, P.Y + 1.2, T0.Z), V3(0, -2.6, 0))
	if tr and tr.Normal.Y >= COS_SLOPE and not isHazardHit(tr) and math.abs(tr.Position.Y - P.Y) < 1.2 then
		T = tr.Position
	end
	if T ~= P and not pathClear(P, T, RADIUS) then return nil end
	local t = flightTime(L.Y - T.Y)
	if not t then return nil end
	local D = flatDist(L, T)
	if D > S.speed * t * CONFIG.ReachSafety - 0.25 then return nil end
	if not arcClear(T, L, t, true, 8) then return nil end
	return {
		kind = "jump", vault = true, pos = L, inst = Linst, takeoff = T,
		cost = flatDist(P, T) + D + CONFIG.JumpPenalty + 1, runup = pickRunup(node, T, d),
	}
end

local function expandHops(node, out, dirs)
	if S.vyReal < 10 or S.speed < 1 then return end
	local gd = flat(goalPos - node.pos)
	for _, d in ipairs(dirs) do
		if vaultExpansions >= CONFIG.MaxVaultExpansions then return end
		if gd.Magnitude < 1 or d:Dot(gd.Unit) > -0.05 then
			vaultExpansions += 1
			local e = buildHop(node, d)
			if e then out[#out + 1] = e end
			checkYield()
		end
	end
end

-- returns pos, inst, cost, isDrop   |   nil, reason ("gap" / "block")
local function tryWalk(a, tx, tz)
	local ay = a.Y
	local su = CONFIG.StepUp
	local down = math.min(su + 0.3 + CONFIG.MaxFall, ay + su + 0.3 - (Workspace.FallenPartsDestroyHeight + 15))
	if down <= su then return nil, "gap" end
	local r = raycast(V3(tx, ay + su + 0.3, tz), V3(0, -down, 0))
	if r and r.Normal.Y >= COS_SLOPE then
		if isHazardHit(r) then
			hazRejects += 1
			lastHazardPart = r.Instance
			return nil, "hazard" -- lava / kill brick = not floor, hop over it
		end
		local slip = isSlipperyHit(r)
		if slip and CONFIG.ForbidSlippery then return nil, "gap" end
		local b = r.Position
		if b.Y < Workspace.FallenPartsDestroyHeight + 15 then return nil, "gap" end
		local dy = b.Y - ay
		local q, ok, drop = b, true, false
		if dy > su then
			ok = rampOK(a, b)
		elseif dy < -su then
			q = V3(b.X, ay, b.Z) -- walk off the ledge, then fall
			drop = true
		end
		if ok and pathClear(a, q, RADIUS) then
			if hazardAtBody(b) or hazardAtBody((a + b) / 2) then
				hazRejects += 1
				return nil, "hazard" -- the step is fine except a hazard sits in it: let the hop logic try to clear it
			end
			local cost = flatDist(a, b) + (drop and (2 + math.abs(dy) * 0.05) or math.abs(dy) * 0.3)
			if slip then
				cost += CONFIG.SlipPenalty
				if CONFIG.SlipEdgePenalty > 0 then cost += slipEdgePenalty(b) end
			end
			return b, r.Instance, cost, drop
		end
	end
	-- steep ramp probe (rise bigger than a step)
	local top = ay + math.min(CELL * math.tan(math.rad(CONFIG.MaxSlopeDeg)), 8)
	local r2 = raycast(V3(tx, top, tz), V3(0, -(top - ay - su), 0))
	if r2 and r2.Normal.Y >= COS_SLOPE then
		local b = r2.Position
		if rampOK(a, b) and pathClear(a, b, RADIUS * 0.5) and not isHazardHit(r2) and not hazardAtBody(b) then
			return b, r2.Instance, flatDist(a, b) + (b.Y - ay) * 0.5, false
		end
	end
	return nil, (r == nil) and "gap" or "block"
end

local function expandWalk(node, out)
	local p = node.pos
	local gaps, blocks = 0, 0
	local bdirs, hdirs = {}, {}
	for i = 1, 8 do
		local o = OFFSETS[i]
		local b, inst, cost, drop = tryWalk(p, p.X + o[1] * CELL, p.Z + o[2] * CELL)
		if b then
			out[#out + 1] = { kind = "walk", pos = b, inst = inst, cost = cost, drop = drop, from = p }
			if drop then gaps += 1 end
		elseif inst == "gap" then
			gaps += 1
		elseif inst == "hazard" then
			gaps += 1
			hdirs[#hdirs + 1] = V3(o[1], 0, o[2]).Unit
		else
			blocks += 1
			bdirs[#bdirs + 1] = V3(o[1], 0, o[2]).Unit
		end
	end
	return gaps, blocks, bdirs, hdirs
end

---------------------------------------------------------------- A*
local function keyOf(p)
	local qx = math.floor(p.X + 0.5) + 100000
	local qz = math.floor(p.Z + 0.5) + 100000
	local qy = math.floor(p.Y * 0.5 + 0.5) + 2000
	return (qx * 200003 + qz) * 4001 + qy
end

local function heapPush(h, item, pri)
	local n = h.n + 1
	h.n = n
	local items, pris = h.items, h.pris
	local i = n
	while i > 1 do
		local parent = i // 2
		if pris[parent] <= pri then break end
		items[i], pris[i] = items[parent], pris[parent]
		i = parent
	end
	items[i], pris[i] = item, pri
end

local function heapPop(h)
	local items, pris, n = h.items, h.pris, h.n
	local top = items[1]
	local item, pri = items[n], pris[n]
	items[n], pris[n] = nil, nil
	n -= 1
	h.n = n
	if n > 0 then
		local i = 1
		while true do
			local c = i * 2
			if c > n then break end
			if c < n and pris[c + 1] < pris[c] then c += 1 end
			if pris[c] >= pri then break end
			items[i], pris[i] = items[c], pris[c]
			i = c
		end
		items[i], pris[i] = item, pri
	end
	return top
end

local function findPath(startPos, startInst, goal, weight)
	local nodes = {}
	local open = { n = 0, items = {}, pris = {} }
	local W = weight or CONFIG.HeuristicWeight
	jumpExpansions = 0
	fallExpansions = 0
	vaultExpansions = 0

	local function getNode(pos, inst)
		local k = keyOf(pos)
		local n = nodes[k]
		if not n then
			n = { pos = pos, inst = inst, g = math.huge, h = heur(pos, goal) }
			nodes[k] = n
		end
		return n
	end

	faceCache = {}
	climbChecks = 0
	bodyCache = {}
	hazRejects = 0
	lastHazardPart = nil
	local s = getNode(startPos, startInst)
	s.g = 0
	s.landing = true
	s.maxH = s.h
	heapPush(open, s, s.h * W)
	local best, count = s, 0
	local bestScore = s.h
	local out = {}

	while open.n > 0 do
		local n = heapPop(open)
		if not n.closed then
			n.closed = true
			count += 1
			if flatDist(n.pos, goal) <= CONFIG.GoalTolerance and math.abs(n.pos.Y - goal.Y) <= 4 then
				return n, true, count
			end
			-- fallback target for unreachable goals: closest node whose route never moved AWAY from the goal
			if n.maxH <= s.h + CONFIG.BacktrackTol then
				local sc = n.h + CONFIG.FallbackPathWeight * n.g
				if sc < bestScore then best, bestScore = n, sc end
			end
			if count >= CONFIG.MaxNodes then break end

			table.clear(out)
			local gaps, blocks, bdirs, hdirs = expandWalk(n, out)
			if n.landing or gaps >= 2 then
				expandJumps(n, out, false)
			elseif gaps + blocks >= 3 then
				expandJumps(n, out, true)
			end
			if (n.landing or gaps >= 2) and goal.Y < n.pos.Y - 4 then
				expandFalls(n, out) -- target is lower: consider dropping off ledges (reach counted per sample)
			end
			if CONFIG.ClimbEnabled and (blocks >= 1 or n.landing) then
				expandClimbs(n, out)
			end
			if CONFIG.VaultEnabled and #bdirs > 0 then
				expandVaults(n, out, bdirs)
			end
			if CONFIG.VaultEnabled and #hdirs > 0 then
				expandHops(n, out, hdirs)
			end

			for _, e in ipairs(out) do
				local m = getNode(e.pos, e.inst)
				if not m.closed then
					local ng = n.g + e.cost
					if ng < m.g then
						m.g, m.parent, m.edge = ng, n, e
						m.pos, m.inst = e.pos, e.inst
						m.landing = (e.kind ~= "walk")
						m.h = heur(m.pos, goal)
						m.maxH = math.max(n.maxH, m.h)
						heapPush(open, m, ng + m.h * W)
					end
				end
			end
		end
		checkYield()
	end
	if s.h - best.h < 2 then best = s end -- no real forward progress possible: stay put
	return best, false, count
end

local function simplify(steps, startPos)
	local out = {}
	local prev = startPos
	for i, st in ipairs(steps) do
		local nxt = steps[i + 1]
		local drop = false
		if st.kind == "walk" and nxt and nxt.kind == "walk" then
			local d1, d2 = flat(st.pos - prev), flat(nxt.pos - st.pos)
			if d1.Magnitude > 0.01 and d2.Magnitude > 0.01
				and d1.Unit:Dot(d2.Unit) > 0.995
				and math.abs((st.pos.Y - prev.Y) / d1.Magnitude - (nxt.pos.Y - st.pos.Y) / d2.Magnitude) < 0.15 then
				drop = true -- collinear, skip waypoint (keeps `prev` as last kept point)
			end
		end
		if not drop then
			out[#out + 1] = st
			prev = (st.kind == "jump") and st.land or (st.kind == "climb" and st.exit or st.pos)
		end
	end
	return out
end

local function buildSteps(endNode, goal, complete, startPos)
	local chain = {}
	local n = endNode
	while n do table.insert(chain, 1, n); n = n.parent end
	local steps = {}
	for i = 2, #chain do
		local e = chain[i].edge
		if e.kind == "climb" then
			local fd = flat(e.truss.Position - e.from)
			steps[#steps + 1] = {
				kind = "climb", truss = e.truss, exit = e.pos, topY = e.topY, botY = e.botY, up = e.up,
				dir = fd.Magnitude > 0.01 and fd.Unit or V3(0, 0, 1),
			}
		elseif e.kind == "jump" then
			local d = flat(e.pos - e.takeoff)
			steps[#steps + 1] = {
				kind = "jump", takeoff = e.takeoff, land = e.pos,
				dir = d.Magnitude > 0.01 and d.Unit or V3(0, 0, 1),
				lip = (e.pos.Y - e.takeoff.Y) > CONFIG.StepUp, vault = e.vault, runup = e.runup,
			}
		elseif e.drop then
			-- walk off a ledge and fall (any depth): handled like a jump with no jump, steered to the landing
			local fd = flat(e.pos - e.from)
			steps[#steps + 1] = {
				kind = "jump", fall = true, takeoff = e.from, land = e.pos,
				dir = fd.Magnitude > 0.01 and fd.Unit or V3(0, 0, 1), lip = false,
			}
		else
			steps[#steps + 1] = { kind = "walk", pos = e.pos }
		end
	end
	if complete then steps[#steps + 1] = { kind = "walk", pos = goal } end
	return simplify(steps, startPos)
end

local function drawPath(steps)
	visuals:ClearAllChildren()
	if not CONFIG.ShowPath then return end
	for i, s in ipairs(steps) do
		if s.kind == "walk" then
			local last = i == #steps
			marker(s.pos, last and WHITE or GREEN, last and 1.4 or 0.7)
		elseif s.kind == "climb" then
			marker(s.exit, Color3.fromRGB(190, 120, 255), 1.1)
		elseif s.fall then
			marker(s.land, Color3.fromRGB(80, 170, 255), 1.1)
		else
			marker(s.takeoff, YELLOW, 0.9)
			marker(s.land, RED, 1.1)
		end
	end
end

