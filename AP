local textScore
do --[[blk]]
local HAZ_STRONG = { "kill", "lava", "death", "deadly", "lethal", "damage", "dmg", "hurt", "harm", "hazard",
	"danger", "spike", "trap", "acid", "poison", "toxic", "fatal", "laser", "burn", "zap", "magma" }
local HAZ_WEAK = { "fire", "saw", "blade", "shock", "electr", "explo", "bomb", "dead", "pain", "oof", "thorn", "flame" }
local SAFE_WORDS = { "safe", "nokill", "antikill", "nodamage", "checkpoint", "spawn", "heal", "deco" }
textScore = function(str)
	str = string.lower(str)
	if string.find(str, "unsafe", 1, true) then return 3 end
	for _, w in ipairs(SAFE_WORDS) do
		if string.find(str, w, 1, true) then return -4 end
	end
	for _, w in ipairs(HAZ_STRONG) do
		if string.find(str, w, 1, true) then return 3 end
	end
	for _, w in ipairs(HAZ_WEAK) do
		if string.find(str, w, 1, true) then return 1.6 end
	end
	return 0
end
end --[[blk]]

local function signature(part) -- colour + material (generalises to "all parts that look like this")
	local c = part.Color
	if math.max(c.R, c.G, c.B) - math.min(c.R, c.G, c.B) < 0.25 then return nil end -- grey/white: too generic
	return string.format("%d,%d,%d,%s", math.floor(c.R * 255), math.floor(c.G * 255), math.floor(c.B * 255), part.Material.Name)
end

local function sigKey(part) -- name + size + colour + material (identifies "this kind of part" across servers)
	local c, sz = part.Color, part.Size
	return string.format("%s|%.1f,%.1f,%.1f|%d,%d,%d|%s", part.Name, sz.X, sz.Y, sz.Z,
		math.floor(c.R * 255), math.floor(c.G * 255), math.floor(c.B * 255), part.Material.Name)
end

local function computeHazard(part)
	local m = manual[part]
	if m ~= nil then return m end
	local key = sigKey(part)
	if saved.safe[key] then return false end
	if saved.haz[key] then return true end
	if (learned[part] or 0) >= 2 then return true end
	local sig = signature(part)
	if sig and (sigHaz[sig] or 0) >= 2 then return true end
	local pts = 0

	local inst, depth = part, 0
	while inst and inst ~= Workspace and depth < 4 do
		local sc = textScore(inst.Name)
		if sc < 0 then return false end
		if sc > 0 then
			pts += sc
			break
		end
		inst, depth = inst.Parent, depth + 1
	end
	for _, tag in ipairs(CollectionService:GetTags(part)) do
		local sc = textScore(tag)
		if sc > 0 then pts += sc break end
	end
	for k, v in pairs(part:GetAttributes()) do
		if textScore(k) > 0 and (v == true or (type(v) == "number" and v > 0)) then pts += 3 break end
	end
	local hasTouch = false
	for _, c in ipairs(part:GetChildren()) do
		local cn = c.ClassName
		if cn == "TouchTransmitter" then
			hasTouch = true
			pts += 1
		elseif cn == "Fire" then
			pts += 1
		elseif cn ~= "Decal" and cn ~= "Texture" then
			local sc = textScore(c.Name)
			if sc > 0 then pts += sc end
		end
	end
	if not part.CanTouch then pts -= 2 end

	-- a row of identical thin touch-enabled bars across a path is the classic obstacle layout
	local sz = part.Size
	if hasTouch and math.min(sz.X, sz.Y, sz.Z) <= 2.5 and part.Parent and part.Parent ~= Workspace then
		local same = 0
		for _, sib in ipairs(part.Parent:GetChildren()) do
			if sib ~= part and sib:IsA("BasePart") and sib.Material == part.Material and sib.Color == part.Color
				and (sib.Size - sz).Magnitude < 0.3 then
				same += 1
				if same >= 2 then break end
			end
		end
		if same >= 2 then pts += 0.8 end
	end

	local col = part.Color
	if col.R >= 0.65 and col.G <= 0.45 and col.B <= 0.25 and col.R - col.G >= 0.3 then pts += 1.6 end
	-- Neon is weak alone, it adds up with the other signals
	if part.Material == Enum.Material.Neon then pts += 1.0 end
	if hasTouch and not part.CanCollide then pts += 1.5 end -- zones / lasers: touch-enabled but you pass through
	return pts >= CONFIG.HazardThreshold
end

local function hazardPart(part)
	if not CONFIG.AvoidHazards or not part then return false end
	local c = hazardCache[part]
	if c == nil then
		local ok, res = pcall(computeHazard, part)
		c = ok and res or false
		hazardCache[part] = c
		if c then setMark(part, true) end
	end
	return c
end

local function isHazardHit(res)
	if not CONFIG.AvoidHazards or not res or not res.Instance then return false end
	if res.Instance:IsA("Terrain") then return false end -- terrain is never a hazard by material
	return hazardPart(res.Instance)
end

-- GetPartBoundsInBox only does a ROUGH bounds test: a long diagonal bar gets treated like the big square
-- around it, so everything near it looked "inside the hazard". Confirm every hit with an exact
-- oriented-box vs oriented-box test (separating axis theorem).
local function obbOverlap(cfA, sizeA, cfB, sizeB)
	local ha, hb = sizeA * 0.5, sizeB * 0.5
	local aAx = { cfA.RightVector, cfA.UpVector, cfA.LookVector }
	local bAx = { cfB.RightVector, cfB.UpVector, cfB.LookVector }
	local aE = { ha.X, ha.Y, ha.Z }
	local bE = { hb.X, hb.Y, hb.Z }
	local t = cfB.Position - cfA.Position
	local function separated(L)
		if L.Magnitude < 1e-6 then return false end
		local ra, rb = 0, 0
		for i = 1, 3 do
			ra += aE[i] * math.abs(aAx[i]:Dot(L))
			rb += bE[i] * math.abs(bAx[i]:Dot(L))
		end
		return math.abs(t:Dot(L)) > ra + rb
	end
	for i = 1, 3 do
		if separated(aAx[i]) or separated(bAx[i]) then return false end
	end
	for i = 1, 3 do
		for j = 1, 3 do
			if separated(aAx[i]:Cross(bAx[j])) then return false end
		end
	end
	return true
end

local function hazardBox(cf, size)
	if not CONFIG.AvoidHazards then return false end
	for _, p in ipairs(Workspace:GetPartBoundsInBox(cf, size, hazardOverlap)) do
		if p.ClassName ~= "Terrain" and hazardPart(p) and obbOverlap(cf, size, p.CFrame, p.Size) then
			lastHazardPart = p
			return true
		end
	end
	return false
end

local function cellKey(p)
	return (math.floor(p.X / 1.5 + 0.5) * 100003 + math.floor(p.Z / 1.5 + 0.5)) * 4001 + math.floor(p.Y / 2 + 0.5)
end

-- would a character standing at `pos` be touching something deadly (even a non-collidable zone)?
local function hazardAtBody(pos)
	if not CONFIG.AvoidHazards then return false end
	local k = cellKey(pos)
	local t = tempBlocked[k]
	if t then
		if t > os.clock() then return true end
		tempBlocked[k] = nil
	end
	local c = bodyCache[k]
	if c == nil then
		c = hazardBox(CFrame.new(pos.X, pos.Y + 2.65, pos.Z), V3(2.3, 5.9, 2.3)) -- body box: feet-0.3 .. head
		bodyCache[k] = c
	end
	return c
end

-- same question, but with the REAL hitbox turned to face `d` (we face where we go): wide across, thin along
local function hazardOriented(pos, d)
	if not CONFIG.AvoidHazards then return false end
	local c = V3(pos.X, pos.Y + 2.65, pos.Z)
	return hazardBox(CFrame.lookAt(c, c + d), V3((S.bodyL or 1.9) * 2, 5.9, (S.bodyF or 0.7) * 2))
end

---------------------------------------------------------------- slippery surfaces
-- friction = the part's CustomPhysicalProperties, else the material default (Ice 0.02, Glacier 0.05, ...)
local matFriction
do --[[blk]]
local matCache = {}
matFriction = function(mat)
	local f = matCache[mat]
	if f == nil then
		local ok, pp = pcall(PhysicalProperties.new, mat)
		f = ok and pp.Friction or 0.3
		matCache[mat] = f
	end
	return f
end
end --[[blk]]

local frictionOfPart
do --[[blk]]
local frictionCache = setmetatable({}, { __mode = "k" })
frictionOfPart = function(part)
	local f = frictionCache[part]
	if f == nil then
		local cp = part.CustomPhysicalProperties
		f = cp and cp.Friction or matFriction(part.Material)
		frictionCache[part] = f
	end
	return f
end
end --[[blk]]

local function isSlipperyPart(part)
	return CONFIG.IceSupport and part ~= nil and frictionOfPart(part) < CONFIG.SlipperyFriction
end

local function isSlipperyHit(res)
	if not CONFIG.IceSupport or not res or not res.Instance then return false end
	if res.Instance:IsA("Terrain") then return matFriction(res.Material) < CONFIG.SlipperyFriction end
	return frictionOfPart(res.Instance) < CONFIG.SlipperyFriction
end

-- on ice, nodes near an edge are expensive: the path hugs the middle of the platform
local function slipEdgePenalty(b)
	local m = CONFIG.SlipEdgeMargin
	local miss = 0
	for _, o in ipairs({ { m, 0 }, { -m, 0 }, { 0, m }, { 0, -m } }) do
		local r = raycast(V3(b.X + o[1], b.Y + 1.2, b.Z + o[2]), V3(0, -2.6, 0))
		if not r or r.Normal.Y < COS_SLOPE then miss += 1 end
	end
	return miss * CONFIG.SlipEdgePenalty
end

---------------------------------------------------------------- jump edges
-- finds the point where we should leave the ground when heading to `dir`
local function findTakeoff(P, dir, maxLen)
	local wall = sweep(P + V3(0, MID_H, 0), dir * maxLen, RADIUS)
	local limit = wall and math.max(0, wall.Distance - 0.05) or maxLen
	local lastP = P
	local k = 1
	while k * 0.5 <= limit do
		local p = P + dir * (k * 0.5)
		local r = raycast(V3(p.X, lastP.Y + 1.2, p.Z), V3(0, -2.6, 0))
		if r and r.Normal.Y >= COS_SLOPE and not isHazardHit(r) then
			lastP = r.Position
		else
			if not (r and isHazardHit(r)) then
				-- the samples are 0.5 studs apart: find the TRUE edge between the last floor sample and this one
				local loD, hiD = (k - 1) * 0.5, k * 0.5
				local edgeP = lastP
				for _ = 1, 5 do
					local midD = (loD + hiD) * 0.5
					local q = P + dir * midD
					local rr = raycast(V3(q.X, lastP.Y + 1.2, q.Z), V3(0, -2.6, 0))
					if rr and rr.Normal.Y >= COS_SLOPE and not isHazardHit(rr) then
						loD, edgeP = midD, rr.Position
					else
						hiD = midD
					end
				end
				lastP = edgeP
			end
			local inset = CONFIG.TakeoffInset
			if r and isHazardHit(r) then inset = CONFIG.HazardClearance end -- ledge is a hazard: keep body clear of it
			local T = lastP - dir * inset
			if (T - P):Dot(dir) < 0 then T = P end
			-- still within body reach of something deadly (non-collidable zone, spikes)? back off more
			local tries = 0
			while tries < 4 and (T - P):Dot(dir) > 0.4 and hazardAtBody(T) do
				T = T - dir * 0.5
				tries += 1
			end
			local edge = lastP
			if r and isHazardHit(r) then edge = nil end -- not a drop-off, just a hazard in front: no late jump from here
			return T, edge
		end
		k += 1
	end
	if wall then return lastP end -- jumping UP onto something: stand-off at the wall
	return nil                    -- floor continues, no ledge here
end

-- horizontal distance we can travel from T along the route before a wall stops the body (sphere sweeps at body height)
local function pathStop(T, L, via)
	local function leg(a, b)
		local v = V3(b.X - a.X, 0, b.Z - a.Z)
		local l = v.Magnitude
		if l < 1e-3 then return nil, 0 end
		local r = sweep(a + V3(0, MID_H, 0), v, RADIUS)
		return r and r.Distance or nil, l
	end
	if via then
		local d1, l1 = leg(T, via)
		if d1 then return d1 end
		local d2 = leg(via, L)
		if d2 then return l1 + d2 end
		return math.huge
	end
	return (leg(T, L)) or math.huge
end

-- body-sized sweeps along the predicted arc: root sphere, HEAD sphere (roofs / overhangs) and optionally legs.
-- Ledge climbs (landing higher than a step) use the real motion: pressed against the wall until the body clears the
-- lip, then sliding forward. edgeD = distance from takeoff to the landing's near edge along the route.
local function arcClear(T, L, t, legs, steps, via, tau, rad, edgeD)
	local N = steps or 5
	tau = tau or 0
	rad = rad or RADIUS
	local legR = (rad < RADIUS) and math.max(rad - 0.05, 0.3) or 0.8
	local len1 = via and flatDist(via, T) or 0
	local total = via and (len1 + flatDist(L, via)) or flatDist(L, T)
	local dhT = L.Y - T.Y
	local lip = dhT > CONFIG.StepUp
	local headOff = math.max((S.headUp or 2.4) - 0.6, 1.0)
	local tClear, stopX = 0, math.huge
	if lip then
		local need = math.max(dhT - S.lift, 0) + 0.1
		local disc = S.vy * S.vy - 2 * S.g * need
		if disc < 0 then return false end
		tClear = (S.vy - math.sqrt(disc)) / S.g
		stopX = math.min(pathStop(T, L, via), math.max(0, (edgeD or (total - CONFIG.LandMargin)) - rad))
	end
	local aim = via or L
	local hv = V3(aim.X - T.X, 0, aim.Z - T.Z)
	local hdir = (hv.Magnitude > 1e-3) and hv.Unit or V3(0, 0, 1)
	local y0 = -0.5 * S.g * tau * tau
	local times = {}
	for i = 0, N do times[#times + 1] = t * i / N end
	if lip and tClear > 0.01 and tClear < t - 0.02 then
		times[#times + 1] = tClear          -- sample the exact moment the body clears the lip
		times[#times + 1] = tClear + 0.012
		table.sort(times)
	end
	local last = #times
	local prev
	for k = 1, last do
		local time = times[k]
		-- distance along the horizontal path
		local dist
		if lip then
			local x
			if time <= tClear then
				x = math.min(S.speed * time, stopX)
			else
				x = math.min(S.speed * tClear, stopX) + S.speed * (time - tClear)
			end
			dist = math.min(x, total)
		elseif tau > 0 then
			-- late jump: full speed while we fall for tau, then uniform
			local early = S.speed * tau
			if time <= tau then
				dist = math.min(S.speed * time, total)
			else
				dist = math.min(total, early + (total - early) * (time - tau) / math.max(t - tau, 1e-3))
			end
		else
			dist = total * (time / t)
		end
		local px, pz
		if via and total > 1e-4 then
			if dist <= len1 then
				local f = (len1 > 1e-4) and dist / len1 or 0
				px, pz = T.X + (via.X - T.X) * f, T.Z + (via.Z - T.Z) * f
			else
				local l2 = total - len1
				local f = (l2 > 1e-4) and (dist - len1) / l2 or 1
				px, pz = via.X + (L.X - via.X) * f, via.Z + (L.Z - via.Z) * f
			end
		else
			local f = (total > 1e-4) and dist / total or 0
			px, pz = T.X + (L.X - T.X) * f, T.Z + (L.Z - T.Z) * f
		end
		local air = time - tau
		local y
		if tau > 0 and time < tau then
			y = -0.5 * S.g * time * time
		else
			y = y0 + S.vy * air - 0.5 * S.g * air * air
		end
		local p = V3(px, T.Y + S.rootH + y, pz)
		if k >= 2 and k < last and hazardBox(CFrame.lookAt(p, p + hdir), V3((S.bodyL or 1.9) * 2, 4.8, (S.bodyF or 0.7) * 2)) then
			return false
		end
		if prev then
			local d = p - prev
			if sweep(prev, d, rad) or raycast(prev + V3(0, 2, 0), d)
				or sweep(prev + V3(0, headOff, 0), d, 0.6)                         -- head: roofs / overhangs
				or (legs and not lip and sweep(prev + V3(0, -1.8, 0), d, legR)) then return false end
		end
		prev = p
	end
	return true
end

local faceCache = {}
local climbChecks = 0
local climbSeen = {}
local badLadders = setmetatable({}, { __mode = "k" })

-- Top walkable face of a part. Works for blocks in ANY orientation (up to 60 degrees of tilt, the biggest of the
-- up-ish faces wins so tilted ramps pick their real top) and for cylinders (their round face is on local X).
local function topFace(part)
	local cached = faceCache[part]
	if cached ~= nil then return cached or nil end
	local face = false
	local skip = (part.ClassName == "Part" and part.Shape == Enum.PartType.Ball)
		or part:IsA("WedgePart") or part:IsA("CornerWedgePart") or part:IsA("TrussPart")
	if not skip then
		local cf, size = part.CFrame, part.Size
		local axes = { cf.RightVector, cf.UpVector, cf.LookVector }
		local sz = { size.X, size.Y, size.Z }
		local isCyl = part.ClassName == "Part" and part.Shape == Enum.PartType.Cylinder
		local best, bestArea = nil, -1
		for i = 1, 3 do
			if not isCyl or i == 1 then
				if math.abs(axes[i].Y) >= COS_LAND then
					local area = sz[i % 3 + 1] * sz[(i + 1) % 3 + 1]
					if area > bestArea then best, bestArea = i, area end
				end
			end
		end
		if best then
			local sign = axes[best].Y >= 0 and 1 or -1
			local j, k = best % 3 + 1, (best + 1) % 3 + 1
			face = {
				center = cf.Position + axes[best] * (sign * sz[best] / 2),
				u = axes[j], v = axes[k], hu = sz[j] / 2, hv = sz[k] / 2,
				thick = sz[best], circle = isCyl, r = math.min(size.Y, size.Z) / 2,
			}
		end
	end
	faceCache[part] = face
	return face or nil
end

-- closest point on the face to P, pulled `margin` inside the edge (circle-aware)
local function nearestOnFace(face, P, margin)
	margin = margin or CONFIG.LandMargin
	local d = P - face.center
	local du, dv = d:Dot(face.u), d:Dot(face.v)
	if face.circle then
		local maxR = math.max(0, face.r - margin)
		local len = math.sqrt(du * du + dv * dv)
		if len > maxR and len > 1e-4 then du, dv = du / len * maxR, dv / len * maxR end
	else
		local mu = math.max(0, face.hu - margin)
		local mv = math.max(0, face.hv - margin)
		du, dv = math.clamp(du, -mu, mu), math.clamp(dv, -mv, mv)
	end
	return face.center + face.u * du + face.v * dv
end

-- real surface under the bounding-box point (handles wavy / bumpy tops); falls back toward the center
local function snapLanding(face, pt)
	local win = math.min(face.thick, 6)
	for _, f in ipairs({ 0, 0.3, 0.6, 1 }) do
		local q = pt:Lerp(face.center, f)
		local r = raycast(V3(q.X, q.Y + 1.5, q.Z), V3(0, -(1.5 + win), 0))
		if r and r.Normal.Y >= COS_LAND and r.Position.Y <= q.Y + 0.6 and not isHazardHit(r) then return r end
	end
	return nil
end

local function arcRel(tt) return S.vy * tt - 0.5 * S.g * tt * tt end -- height above takeoff ground after tt seconds

-- LEDGE CLIMB (landing higher than a step). Physics:
--   * limbs have CanCollide = false: only the root part / torso / head hit the world. The collision body bottom is
--     about S.lift studs ABOVE the feet, so the feet only need to reach (dh - lift), not dh.
--   * until the body clears the lip we are pressed against the wall and cannot move forward (wallD = distance to
--     the edge). Once it clears, we have until the body drops back below the lip to slide the root over the edge.
-- returns the air time (for arc checks / steering) or nil when this player can't do it.
local function liftFit(dh, wallD)
	local need = math.max(dh - S.lift, 0) + 0.1        -- height the feet must reach
	local disc = S.vy * S.vy - 2 * S.g * need
	if disc < 0 then return nil end                    -- apex too low
	local sq = math.sqrt(disc)
	local tClear = (S.vy - sq) / S.g                   -- body clears the lip
	local tOver  = (S.vy + sq) / S.g                   -- body drops back below the lip
	if tOver - tClear < CONFIG.MinLiftWindow then return nil end
	local before = math.min(S.speed * tClear, wallD)   -- forward progress possible before the wall stops us
	local reach = before + S.speed * (tOver - tClear)
	if reach * CONFIG.ReachSafety >= wallD + 0.3 then return tOver end -- root must end up 0.3 past the edge
	return nil
end

-- air time for a jump of height dh over a horizontal path of length `dist` (landing inset `mEff` from the edge)
local function fitJump(dh, dist, mEff)
	if dh > CONFIG.StepUp then
		return liftFit(dh, math.max(0, dist - mEff))
	end
	local t = flightTime(dh)
	if t and dist <= S.speed * t * CONFIG.ReachSafety - 0.1 then return t end
	return nil
end

local buildHop                              -- defined with the hazard code below

local function pathClear(a, q, radius)
	local d = q - a
	if sweep(a + V3(0, MID_H, 0), d, radius) then return false end
	if raycast(a + V3(0, HEAD_H, 0), d) then return false end
	return true
end

local function narrowR() return math.max(S.bodyF or 0.7, 0.6) end -- body radius when turned sideways

-- takeoff spots where a jump already failed are avoided for a while (so a re-plan picks another way)
local function isBadTake(p)
	local now = os.clock()
	local list = S.bad
	for i = #list, 1, -1 do
		local b = list[i]
		if b.exp < now then
			table.remove(list, i)
		elseif flatDist(b.pos, p) < 1.5 and math.abs(b.pos.Y - p.Y) < 2 then
			return true
		end
	end
	return false
end

-- is the floor continuous (walkable, not a hazard) on the straight line a -> b?
local function floorLine(a, b)
	local dx, dz = b.X - a.X, b.Z - a.Z
	local n = math.max(1, math.ceil(math.sqrt(dx * dx + dz * dz)))
	for i = 1, n do
		local f = i / n
		local r = raycast(V3(a.X + dx * f, a.Y + 1.2, a.Z + dz * f), V3(0, -2.6, 0))
		if not r or r.Normal.Y < COS_SLOPE or math.abs(r.Position.Y - a.Y) > CONFIG.StepUp or isHazardHit(r) then
			return false
		end
	end
	return true
end

local buildJump
do --[[blk]]
local FAN = { 0, 0.4, -0.4, 0.8, -0.8 } -- takeoff search directions around the straight line to the landing (rad)
local CURVE_OFFS = { 2.2, 3.6, 5.4, 7.5 }   -- how far the arch swings out sideways (studs)
local CURVE_FRACS = { 0.5, 0.3, 0.7 }       -- where along the straight line the swing is widest
buildJump = function(node, face, pt, m, allowCurve)
	local P = node.pos
	local r = snapLanding(face, pt)
	if not r then return nil end
	local L = r.Position
	local fv = V3(L.X - P.X, 0, L.Z - P.Z)
	local fd = fv.Magnitude
	if fd < 0.2 then return nil end
	local dir = fv / fd
	if hazardOriented(L, dir) then
		-- the landing sits next to a hazard: hop it instead (land PAST it, using the hazard's real shape)
		if allowCurve and buildHop then return buildHop(node, dir) end
		return nil
	end
	local mEff = math.min(m or CONFIG.LandMargin, face.circle and face.r or math.min(face.hu, face.hv))
	local slipPen = isSlipperyHit(r) and CONFIG.SlipPenalty or 0
	local Ts = {}

	-- 1. straight jumps: the straight line P -> L can run into a wall or miss the ledge, so try a fan of takeoffs
	for _, ang in ipairs(FAN) do
		local c, sn = math.cos(ang), math.sin(ang)
		local dd = V3(dir.X * c - dir.Z * sn, 0, dir.X * sn + dir.Z * c)
		local T, edge = findTakeoff(P, dd, math.min(fd + 2, CONFIG.EdgeScan))
		if T then
			Ts[#Ts + 1] = T
			if not isBadTake(T) then
				local dh = L.Y - T.Y
				local hd = flatDist(L, T)
				local t = (hd >= 0.3) and fitJump(dh, hd, mEff) or nil
				if t then
					if arcClear(T, L, t, nil, nil, nil, nil, nil, hd - mEff) then
						return {
							kind = "jump", pos = L, inst = r.Instance, takeoff = T, inset = mEff,
							cost = flatDist(P, T) + hd + CONFIG.JumpPenalty + slipPen,
						}
					elseif CONFIG.NarrowSqueeze and CONFIG.FakeShiftlock
						and arcClear(T, L, t, false, 6, nil, nil, narrowR(), hd - mEff) then
						-- the gap between walls is too tight for the body face-on: go through sideways
						return {
							kind = "jump", pos = L, inst = r.Instance, takeoff = T, narrow = true, inset = mEff,
							cost = flatDist(P, T) + hd + CONFIG.JumpPenalty + slipPen + 1.5,
						}
					end
				end
				-- JUMP EXTENDER: the ordinary takeoff is too short. Turned sideways the root part's long side lies along the
				-- jump and the floor sensor keeps us "grounded" until the whole root part is over the edge, so we can
				-- leave the ground with the centre up to S.extend PAST the edge.
				if CONFIG.JumpExtender and CONFIG.FakeShiftlock and edge and S.extend > 0.1 and dh <= CONFIG.StepUp then
					local Tx = edge + dd * (S.extend - CONFIG.TakeoffInset)
					Tx = V3(Tx.X, T.Y, Tx.Z)
					if not isBadTake(Tx) then
						local hdx = flatDist(L, Tx)
						local tx = (hdx >= 0.3) and fitJump(L.Y - Tx.Y, hdx, mEff) or nil
						if tx and arcClear(Tx, L, tx, nil, nil, nil, nil, nil, hdx - mEff) then
							return {
								kind = "jump", pos = L, inst = r.Instance, takeoff = Tx, ext = true, edgePt = edge, inset = mEff,
								cost = flatDist(P, Tx) + hdx + CONFIG.JumpPenalty + slipPen + 0.5,
							}
						end
					end
				end
				-- LATE JUMP: too far for an ordinary jump? run off the ledge and jump a moment later in mid-air.
				-- The extra fall time carries us further forward (the jump start is "extended").
				if edge and CONFIG.MaxLateJump > 0 and L.Y - edge.Y <= CONFIG.StepUp then
					local need = flatDist(L, edge)
					local tt, tau = fitReach(L.Y - edge.Y, need, true)
					if tt and tau > 0 and need >= S.speed * tau + 0.5 and arcClear(edge, L, tt, false, 8, nil, tau) then
						return {
							kind = "jump", pos = L, inst = r.Instance, takeoff = edge, late = tau,
							cost = flatDist(P, edge) + need + CONFIG.JumpPenalty + 1 + slipPen,
						}
					end
				end
			end
		end
	end
	if not allowCurve then return nil end

	-- 2. arch jumps: a wall / pillar sits on the straight line but you can steer in mid-air, so swing out
	--    around its side (path T -> W -> L). The horizontal path is longer, so reach is checked on its LENGTH.
	for i = 1, math.min(#Ts, 3) do
		local T = Ts[i]
		local dh = L.Y - T.Y
		local tv = V3(L.X - T.X, 0, L.Z - T.Z)
		local hd = tv.Magnitude
		if hd >= 1.0 and not isBadTake(T) then
			local fwd = tv / hd
			local perp = V3(-fwd.Z, 0, fwd.X)
			for _, off in ipairs(CURVE_OFFS) do
				for _, frac in ipairs(CURVE_FRACS) do
					for _, side in ipairs({ 1, -1 }) do
						local W = T + fwd * (hd * frac) + perp * (off * side)
						local plen = flatDist(T, W) + flatDist(W, L)
						local t = fitJump(dh, plen, mEff)
						if t and arcClear(T, L, t, true, 8, W, nil, nil, plen - mEff) then
							return {
								kind = "jump", pos = L, inst = r.Instance, takeoff = T, via = W, inset = mEff,
								cost = flatDist(P, T) + plen + CONFIG.JumpPenalty + 3 + slipPen,
							}
						end
					end
				end
			end
		end
	end

	-- 2b. BACK-OUT: jump and drift BACKWARD (away from the wall / out from under the roof) while the body keeps facing
	--     the ledge, then come forward over the lip. Path T -> W (behind T, optionally a bit sideways) -> L.
	--     Nothing is assumed: the head / body sweeps at sampled moments of the arc (including the exact moment the body
	--     clears the lip) and the speed * air time budget decide whether it works for THIS roof and THIS player.
	if (L.Y - P.Y) > CONFIG.StepUp then
		for i = 1, math.min(#Ts, 2) do
			local T = Ts[i]
			if not isBadTake(T) then
				local dh = L.Y - T.Y
				local tv = V3(L.X - T.X, 0, L.Z - T.Z)
				local hd = tv.Magnitude
				if hd >= 0.3 then
					local fwd = tv / hd
					local perp = V3(-fwd.Z, 0, fwd.X)
					for _, back in ipairs({ 1, 1.8, 2.6, 3.6 }) do
						for _, side in ipairs({ 0, 1.2, -1.2, 2.5, -2.5 }) do
							local W = T - fwd * back + perp * side
							local plen = flatDist(T, W) + flatDist(W, L)
							local t = fitJump(dh, plen, mEff)
							if t and arcClear(T, L, t, nil, 10, W, nil, nil, plen - mEff) then
								return {
									kind = "jump", pos = L, inst = r.Instance, takeoff = T, via = W, backout = true, inset = mEff,
									cost = flatDist(P, T) + plen + CONFIG.JumpPenalty + 3.5 + slipPen,
								}
							end
						end
						checkYield()
					end
				end
			end
		end
	end

	-- 3. HEADROOM / SIDE-STEP: the straight takeoff can sit under a roof (the head would bump it). Look for a takeoff
	--    spot with open air above it: slide along the wall and back away from it. While jumping the body keeps
	--    facing the ledge (fake shiftlock), so the thin side leads and we may strafe / walk backward in the air.
	if (L.Y - P.Y) > CONFIG.StepUp and Ts[1] and S.slideN < 40 then
		S.slideN += 1
		local T0 = Ts[1]
		local perp = V3(-dir.Z, 0, dir.X)
		for _, back in ipairs({ 0, 1.5, 3 }) do
			for _, side in ipairs({ 0, 1.5, -1.5, 3, -3, 5, -5, 7, -7 }) do
				if back > 0 or side ~= 0 then
					local Q = T0 - dir * back + perp * side
					local g = raycast(V3(Q.X, T0.Y + 1.2, Q.Z), V3(0, -2.6, 0))
					if g and g.Normal.Y >= COS_SLOPE and math.abs(g.Position.Y - T0.Y) <= 0.6 and not isHazardHit(g) then
						local Qp = g.Position
						if not isBadTake(Qp) and not hazardAtBody(Qp) and floorLine(P, Qp) and pathClear(P, Qp, RADIUS) then
							local r2 = snapLanding(face, nearestOnFace(face, Qp, mEff))
							if r2 then
								local L2 = r2.Position
								local hd2 = flatDist(L2, Qp)
								local t2 = (hd2 >= 0.3) and fitJump(L2.Y - Qp.Y, hd2, mEff) or nil
								if t2 and arcClear(Qp, L2, t2, nil, 8, nil, nil, nil, hd2 - mEff)
									and not hazardOriented(L2, V3(L2.X - Qp.X, 0, L2.Z - Qp.Z).Unit) then
									return {
										kind = "jump", pos = L2, inst = r2.Instance, takeoff = Qp, inset = mEff,
										cost = flatDist(P, Qp) + hd2 + CONFIG.JumpPenalty + 2 + slipPen,
									}
								end
							end
						end
					end
				end
			end
			checkYield()
		end
	end
	return nil
end
end --[[blk]]

local function expandJumps(node, out, climbOnly)
	if S.vyReal < 10 or S.speed < 1 then return end
	if jumpExpansions >= CONFIG.MaxJumpExpansions then return end
	jumpExpansions += 1
	local P = node.pos
	local maxFall = math.max(0, math.min(CONFIG.MaxFall, P.Y - (Workspace.FallenPartsDestroyHeight + 15)))
	local tMax = flightTime(-maxFall)
	if not tMax then return end
	local radius = math.min(S.speed * tMax + CONFIG.EdgeScan, CONFIG.MaxQueryRadius)
	local parts = Workspace:GetPartBoundsInRadius(P, radius, overlapParams)
	local cands = {}
	for _, part in ipairs(parts) do
		if part ~= node.inst and part.ClassName ~= "Terrain" then
			local face = topFace(part)
			if face and not hazardPart(part) and not (CONFIG.ForbidSlippery and isSlipperyPart(part)) then
				local pt = nearestOnFace(face, P)
				local dh = pt.Y - P.Y
				local fd = flatDist(pt, P)
				-- highest ledge we can mount = apex + lift (torso clears the lip, legs don't collide)
				if dh <= S.maxH + S.lift - 0.1 and dh >= -maxFall and (fd > 2.2 or dh > CONFIG.StepUp)
					and (not climbOnly or dh > CONFIG.StepUp) then
					local t = flightTime(dh > CONFIG.StepUp and (dh - S.lift) or dh)
					if t and fd - CONFIG.EdgeScan <= S.speed * t * CONFIG.ReachSafety then
						local skip = false
						if math.abs(dh) <= CONFIG.StepUp then
							-- same level and floor continuous between us = walkable, no jump needed
							local mid = (P + pt) / 2
							if raycast(V3(mid.X, P.Y + 1.2, mid.Z), V3(0, -2.4, 0)) then skip = true end
						end
						if not skip then
							cands[#cands + 1] = { pt = pt, pt2 = nearestOnFace(face, P, 0.7), pt3 = nearestOnFace(face, P, 0.35), face = face, score = heur(pt, goalPos) + fd * 0.25 }
						end
					end
				end
			end
		end
	end
	table.sort(cands, function(a, b) return a.score < b.score end)
	for i = 1, math.min(#cands, CONFIG.MaxJumpCandidates) do
		local e = buildJump(node, cands[i].face, cands[i].pt, CONFIG.LandMargin, i <= 3)
		if not e then e = buildJump(node, cands[i].face, cands[i].pt2, 0.7, i <= 3) end
		if not e then e = buildJump(node, cands[i].face, cands[i].pt3, 0.35, i <= 3) end
		if e then out[#out + 1] = e end
		checkYield()
	end
end

-- Ladders / climbables, detected by SHAPE only (names, tags and attributes are never used):
--   * TrussPart: the engine climbs those itself (Climbing state), so the class IS the shape.
--   * RUNG STACK: >= 3 thin walkable blocks (bars / steps / ledges) stacked one above another: their top faces overlap
--     horizontally and the vertical gaps are within what THIS player can jump. Works for rung ladders attached to a wall
--     and for free-standing ones. A prop that is merely called "Ladder" but has no such shape is ignored, and a wall of
--     unnamed bars is found.
--   A ladder climbs like a truss: we walk INTO it and hold the move direction toward it (that is "up"), facing it with
--   the fake shiftlock. We WATCH the height: if we are not gaining height the ladder is marked bad for a while and we
--   re-plan (the rungs are still normal ledges, so the jump planner can use them instead).
local expandClimbs
do --[[blk]]
local function rungLike(part)
	if part.ClassName == "Terrain" or not part:IsA("BasePart") or not part.CanCollide then return nil end
	local face = topFace(part)
	if not face or face.thick > 3.2 then return nil end
	local w, mn = math.max(face.hu, face.hv) * 2, math.min(face.hu, face.hv) * 2
	if w > 12 or mn < 0.35 then return nil end
	return face
end

local function stackOf(part)
	local cached = S.rungs[part]
	if cached ~= nil then return cached or nil end
	S.rungs[part] = false
	local f0 = rungLike(part)
	if not f0 or hazardPart(part) then return nil end
	local c0 = f0.center
	local reachXZ = math.max(f0.hu, f0.hv) + 1.3
	local side = math.max(f0.hu, f0.hv) * 2 + 3
	local maxGap = math.min(S.maxH + S.lift - 0.8, 5.5)
	local items = {}
	for _, q in ipairs(Workspace:GetPartBoundsInBox(CFrame.new(c0), V3(side, 140, side), overlapParams)) do
		local fq = (q == part) and f0 or rungLike(q)
		if fq and (q == part or not hazardPart(q)) and flatDist(fq.center, c0) <= reachXZ then
			items[#items + 1] = { part = q, face = fq, y = fq.center.Y }
		end
	end
	table.sort(items, function(a, b) return a.y < b.y end)
	-- parts at the same height form one level
	local levels = {}
	for _, it in ipairs(items) do
		local lv = levels[#levels]
		if lv and it.y - lv.y < 0.5 then
			lv.items[#lv.items + 1] = it
		else
			levels[#levels + 1] = { y = it.y, items = { it } }
		end
	end
	local li
	for i, lv in ipairs(levels) do
		for _, it in ipairs(lv.items) do
			if it.part == part then li = i end
		end
	end
	if not li then return nil end
	local lo, hi = li, li
	while lo > 1 do
		local gap = levels[lo].y - levels[lo - 1].y
		if gap >= 1.0 and gap <= maxGap then lo -= 1 else break end
	end
	while hi < #levels do
		local gap = levels[hi + 1].y - levels[hi].y
		if gap >= 1.0 and gap <= maxGap then hi += 1 else break end
	end
	local n = hi - lo + 1
	if n < 3 then return nil end
	local sx, sz, hw = 0, 0, 0
	for i = lo, hi do
		local it = levels[i].items[1]
		sx += it.face.center.X
		sz += it.face.center.Z
		hw = math.max(hw, it.face.hu, it.face.hv)
	end
	local top = levels[hi].items[1]
	local st = {
		base = levels[lo].items[1].part, topY = levels[hi].y, botY = levels[lo].y,
		cx = sx / n, cz = sz / n, hw = hw + 0.3, n = n, topPos = top.face.center,
		baseCenter = levels[lo].items[1].face.center,
	}
	for i = lo, hi do
		for _, it in ipairs(levels[i].items) do S.rungs[it.part] = st end
	end
	return st
end

local function ladderOf(part)
	if part.ClassName == "TrussPart" then return part, "truss" end
	local st = stackOf(part)
	if st then return st.base, "rung", st end
	return nil
end

local function objBox(obj)
	if obj:IsA("Model") then
		local ok, cf, size = pcall(function() return obj:GetBoundingBox() end)
		if ok then return cf, size end
		return nil
	end
	return obj.CFrame, obj.Size
end

-- A rung ladder is only usable from where we can SEE and WALK to its rungs. Without this, a ladder on the far side of a
-- thick wall counted as "close" and the planner tried to climb the wall itself.
local function rungAccess(P, st)
	-- 1. line of sight from body height to the lowest rung: the first thing hit must be a rung of this stack
	local from = P + V3(0, MID_H, 0)
	local d = st.baseCenter - from
	local len = d.Magnitude
	if len > 0.5 then
		local res = raycast(from, d * (1 + 0.6 / len))
		if res and S.rungs[res.Instance] ~= st and res.Distance < len - 0.7 then return false end
	end
	-- 2. a straight, walkable approach up to the rungs
	local hx, hz = st.cx - P.X, st.cz - P.Z
	local hl = math.sqrt(hx * hx + hz * hz)
	if hl > st.hw + 1.0 then
		local k = (hl - st.hw - 0.8) / hl
		local A = V3(P.X + hx * k, P.Y, P.Z + hz * k)
		if not pathClear(P, A, RADIUS) or not floorLine(P, A) then return false end
	end
	return true
end

expandClimbs = function(node, out)
	if climbChecks >= CONFIG.MaxClimbChecks then return end
	local P = node.pos
	-- one scan per 3-stud cell is plenty (landing nodes always scan)
	local ck = (math.floor(P.X / 3) * 100003 + math.floor(P.Z / 3)) * 4001 + math.floor(P.Y / 3)
	if climbSeen[ck] and not node.landing then return end
	climbSeen[ck] = true
	climbChecks += 1
	local parts = Workspace:GetPartBoundsInRadius(P, 5, hazardOverlap) -- also sees non-collidable trusses
	local seen = {}
	for _, part in ipairs(parts) do
		local obj, kind, st = ladderOf(part)
		if obj and not seen[obj] and (badLadders[obj] or 0) < os.clock() then
			seen[obj] = true
			local cf, size
			if kind == "rung" then
				cf = CFrame.new(st.cx, (st.topY + st.botY) / 2, st.cz)
				size = V3(st.hw * 2, math.max(st.topY - st.botY, 0.1), st.hw * 2)
			else
				cf, size = objBox(obj)
			end
			if cf then
				local ext = 0.5 * (size.Y * math.abs(cf.UpVector.Y)
					+ size.X * math.abs(cf.RightVector.Y) + size.Z * math.abs(cf.LookVector.Y))
				local c = cf.Position
				local topY, botY = c.Y + ext, c.Y - ext
				local hw = math.max(size.X, size.Z) * 0.5
				local okShape = (kind == "truss" and math.abs(cf.UpVector.Y) >= 0.8) or kind == "rung"
				if okShape and flatDist(P, c) - hw <= 3.2 and (kind ~= "rung" or rungAccess(P, st)) then
					for _, up in ipairs(kind == "rung" and { true } or { true, false }) do
						local can = (up and (P.Y <= botY + 4 and topY - P.Y >= 3))
							or (not up and (P.Y >= topY - 4 and P.Y - botY >= 3))
						if can then
							local best
							for a2 = 0, 7 do
								local ang = a2 * math.pi / 4
								local x, z = c.X + math.cos(ang) * (hw + 2), c.Z + math.sin(ang) * (hw + 2)
								local r = raycast(V3(x, up and (topY + 2.5) or (botY + 4), z), V3(0, -7, 0))
								if r and r.Instance ~= obj and not r.Instance:IsDescendantOf(obj)
									and r.Normal.Y >= COS_LAND and not isHazardHit(r) then
									local ey = r.Position.Y
									local ok = (up and (ey >= P.Y + 3 and ey <= topY + 1.2))
										or (not up and (ey <= P.Y - 3 and ey >= botY - 3))
									if ok then
										local sc = (r.Position - goalPos).Magnitude
										if not best or sc < best.sc then best = { r = r, sc = sc } end
									end
								end
							end
							if kind == "rung" and up then
								-- the top rung itself is always a valid place to end the climb
								local tp = st.topPos
								local r = raycast(V3(tp.X, st.topY + 1.5, tp.Z), V3(0, -3, 0))
								if r and r.Normal.Y >= COS_LAND and not isHazardHit(r) then
									local sc = (r.Position - goalPos).Magnitude
									if not best or sc < best.sc then best = { r = r, sc = sc } end
								end
							end
							if best then
								local E = best.r.Position
								local custom = kind == "rung"
								out[#out + 1] = {
									kind = "climb", pos = E, inst = best.r.Instance, truss = obj,
									topY = topY, botY = botY, up = up, from = P, cpos = c,
									custom = custom, reach = hw + 1.8,
									cost = math.abs(E.Y - P.Y) * (custom and 1.6 or 0.8) + flatDist(P, E) + (custom and 8 or 3),
								}
							end
						end
					end
				end
			end
		end
	end
end
end --[[blk]]

-- Falls onto ANY ground (terrain included). For every direction we sample the ground below at growing
-- distances from the ledge; each sample's own depth gives its own air time, so the horizontal reach is
-- counted per sample:   t = (vy + sqrt(vy^2 + 2*g*depth)) / g,   reach = WalkSpeed * t.   Deeper = farther.
local expandFalls
do --[[blk]]
local FALL_DIRS = 8
local FALL_RADII = { 2.5, 4, 6, 9, 13, 18, 25, 35, 50, 70, 100 }

expandFalls = function(node, out)
	if S.vyReal < 10 or S.speed < 1 then return end
	if fallExpansions >= CONFIG.MaxFallExpansions then return end
	fallExpansions += 1
	local P = node.pos
	local voidY = Workspace.FallenPartsDestroyHeight + 15
	local found = {}
	for k = 0, FALL_DIRS - 1 do
		local ang = k * (2 * math.pi / FALL_DIRS)
		local dir = V3(math.cos(ang), 0, math.sin(ang))
		local T = findTakeoff(P, dir, CONFIG.EdgeScan)
		if T then
			local depthMax = math.min(CONFIG.MaxFall, T.Y - voidY)
			local best
			if depthMax > 1 then
				for _, r in ipairs(FALL_RADII) do
					local q = T + dir * r
					local hit = raycast(V3(q.X, T.Y + 2, q.Z), V3(0, -(2 + depthMax), 0))
					if hit and hit.Normal.Y >= COS_LAND and not isHazardHit(hit) and hit.Position.Y < T.Y - 1
						and not (CONFIG.ForbidSlippery and isSlipperyHit(hit)) then
						local L = hit.Position
						local t = flightTime(L.Y - T.Y)
						if t and flatDist(L, T) <= S.speed * t * CONFIG.ReachSafety - 0.25 then
							local sc = heur(L, goalPos)
							if not best or sc < best.sc then best = { L = L, inst = hit.Instance, T = T, sc = sc, slip = isSlipperyHit(hit) } end
						end
					end
				end
			end
			if best then found[#found + 1] = best end
		end
		checkYield()
	end
	table.sort(found, function(a, b) return a.sc < b.sc end)
	for i = 1, math.min(#found, 3) do
		local c = found[i]
		local t = flightTime(c.L.Y - c.T.Y)
		if t and not hazardAtBody(c.L) and arcClear(c.T, c.L, t) then
			out[#out + 1] = {
				kind = "jump", pos = c.L, inst = c.inst, takeoff = c.T,
				cost = flatDist(P, c.T) + flatDist(c.L, c.T) + CONFIG.JumpPenalty + (c.slip and CONFIG.SlipPenalty or 0),
			}
		end
		checkYield()
	end
end
end --[[blk]]

---------------------------------------------------------------- walk edges
local function rampOK(a, b)
	local mx, mz, my = (a.X + b.X) / 2, (a.Z + b.Z) / 2, (a.Y + b.Y) / 2
	local r = raycast(V3(mx, my + 1.2, mz), V3(0, -2.4, 0))
	return r ~= nil and r.Normal.Y >= COS_SLOPE and math.abs(r.Position.Y - my) < 0.7
end

-- Vault: a wall blocks the way (  _|_  ). Nothing about the wall is hardcoded: how thick / how tall it may be
-- comes from THIS player's JumpPower|JumpHeight, gravity and WalkSpeed.
--   air time      t   = (vy + sqrt(vy^2 - 2*g*dh)) / g          (dh = landing height - takeoff height)
--   reach         D   <= WalkSpeed * t * ReachSafety             -> the farthest landing we could ever make
--   max wall      height <= apex of the jump (vy^2 / 2g), thickness <= reach - run-up - landing offset
-- For every run-up distance b before the wall face we check the arc ANALYTICALLY (feet above the wall top
-- while we are horizontally over the wall), then confirm with body + leg sweeps.

-- farthest horizontal distance this player could ever land from P (deepest possible landing = the void)
local function reachLimit(P)
	local depth = math.max(0, math.min(CONFIG.MaxFall, P.Y - (Workspace.FallenPartsDestroyHeight + 15)))
	local t = flightTime(-depth)
	return t and S.speed * t * CONFIG.ReachSafety or 0
end

-- how far behind the takeoff point we start running: 1.4 normally, longer on ice (slow acceleration)
local function pickRunup(node, T, d)
	local ru = 1.4
	if node.inst and CONFIG.IceSupport and isSlipperyPart(node.inst) then
		ru = math.clamp(S.speed * S.speed / (2 * S.iceAccel) * 0.8, 1.4, 9)
	end
	if ru > 1.4 then
		local R0 = T - d * ru
		local rr = raycast(V3(R0.X, T.Y + 1.2, R0.Z), V3(0, -2.6, 0))
		if not (rr and rr.Normal.Y >= COS_SLOPE and not isHazardHit(rr)) then ru = 1.4 end
	end
	return ru
end

local function buildVault(node, d)
	local P = node.pos
	local wall = sweep(P + V3(0, MID_H, 0), d * 3.4, RADIUS)
	if not wall then return nil end
	local face = wall.Distance + RADIUS -- distance from P to the wall face
	-- anything at apex height in the way = wall taller than this player can ever clear
	if sweep(P + V3(0, S.maxH + 0.2, 0), d * (face + 1.5), 0.5) then return nil end

	local limit = reachLimit(P)
	local depth = math.max(0, math.min(CONFIG.MaxFall, P.Y - (Workspace.FallenPartsDestroyHeight + 15)))
	local top0 = P.Y + S.maxH + 1
	local down = S.maxH + 1 + depth

	-- walk the columns behind the face until the wall ends; the scan is bounded by REACH, not a constant
	local sFar, Hw = nil, P.Y
	local s = face + 0.25
	while s - face <= limit do
		local q = P + d * s
		local hit = raycast(V3(q.X, top0, q.Z), V3(0, -down, 0))
		if not hit then return nil end -- void beyond
		local y = hit.Position.Y
		if y > P.Y + CONFIG.StepUp then
			Hw = math.max(Hw, y)
		else
			if hit.Normal.Y >= COS_SLOPE and not isHazardHit(hit) then sFar = s end
			break
		end
		s += (s - face < 8) and 0.5 or 1.0
	end
	if not sFar then return nil end
	local thick = sFar - face

	-- landing a bit past the wall's far face
	local L, Linst
	for _, extra in ipairs({ 1.0, 0.5, 0 }) do
		local q = P + d * (sFar + extra)
		local hit = raycast(V3(q.X, top0, q.Z), V3(0, -down, 0))
		if hit and hit.Normal.Y >= COS_LAND and not isHazardHit(hit) and hit.Position.Y <= P.Y + CONFIG.StepUp
			and not hazardAtBody(hit.Position) then
			L, Linst = hit.Position, hit.Instance
			break
		end
	end
	if not L then return nil end

	-- run-up search: shortest run-up that clears the wall; stop as soon as the jump would be too long to reach
	local Hrel = Hw - P.Y
	local b = 1.2
	while true do
		local T0 = P + d * (face - b)
		local tr = raycast(V3(T0.X, P.Y + 1.2, T0.Z), V3(0, -2.6, 0))
		if not (tr and tr.Normal.Y >= COS_SLOPE and not isHazardHit(tr) and math.abs(tr.Position.Y - P.Y) < 1.2) then
			if b > face + 0.5 then break end -- ran out of floor behind us
		else
			local T = tr.Position
			local t = flightTime(L.Y - T.Y)
			if not t then break end
			local D = flatDist(L, T)
			if D > S.speed * t * CONFIG.ReachSafety - 0.25 then break end -- longer run-up = longer jump: impossible from here on
			local u = D / t -- horizontal speed we need along the arc
			local x0, x1 = math.max(0, b - 0.5), b + thick + 0.5
			if arcRel(x0 / u) >= Hrel + 0.3 and arcRel(x1 / u) >= Hrel + 0.3
				and not hazardAtBody(T)
				and (face - b >= 0 or pathClear(P, T, RADIUS))
				and arcClear(T, L, t, true, 8) then
				return {
					kind = "jump", vault = true, pos = L, inst = Linst, takeoff = T,
					cost = flatDist(P, T) + D + CONFIG.JumpPenalty + 2, runup = pickRunup(node, T, d),
				}
			end
		end
		b += 0.6
	end
	return nil
end

local function expandVaults(node, out, dirs)
	if S.vyReal < 10 or S.speed < 1 then return end
	local gd = flat(goalPos - node.pos)
	for _, d in ipairs(dirs) do
		if vaultExpansions >= CONFIG.MaxVaultExpansions then return end
		if gd.Magnitude < 1 or d:Dot(gd.Unit) > -0.05 then -- only walls between us and the goal
			vaultExpansions += 1
			local e = buildVault(node, d)
			if e then out[#out + 1] = e end
			checkYield()
		end
	end
end

-- Hop: a hazard (lava stripe, kill bar) lies across the way. We use the hazard's ACTUAL SHAPE:
--   1. for the direction we want to go, intersect that line with the hazard's box grown by our HITBOX
--      (turned to face that way: thin along the line, wide across) -> the exact stretch [S0, S1] of the
--      line where our body would touch it (any angle, any length)
--   2. take off just before S0 (or from the ledge before a gap that comes first), land just after S1
--   3. ask the jump physics whether that fits: normal jump, or a LATE jump (run off the ledge, jump a moment
--      later = longer reach). Sweep the arc (body + legs). If it fits -> jump, if not -> not possible.
do --[[blk]]
local BODY_OFF = 2.65 -- body box centre above the feet

-- where along the ray (origin o, unit direction d) is the body CENTRE inside this part's box grown by the hitbox?
local function zoneAlong(part, o, d)
	local cf, half = part.CFrame, part.Size * 0.5
	local lo, ld = cf:PointToObjectSpace(o), cf:VectorToObjectSpace(d)
	local axes = { cf.RightVector, cf.UpVector, cf.LookVector }
	local ext = { half.X, half.Y, half.Z }
	local los = { lo.X, lo.Y, lo.Z }
	local lds = { ld.X, ld.Y, ld.Z }
	local hl, hf = S.bodyL or 1.9, S.bodyF or 0.7
	local lat = V3(-d.Z, 0, d.X)
	local tmin, tmax = -math.huge, math.huge
	for i = 1, 3 do
		local a = axes[i]
		local e = ext[i] + hl * math.abs(a:Dot(lat)) + 2.95 * math.abs(a.Y) + hf * math.abs(a:Dot(d))
		if math.abs(lds[i]) < 1e-6 then
			if math.abs(los[i]) > e then return nil end
		else
			local t1, t2 = (-e - los[i]) / lds[i], (e - los[i]) / lds[i]
			if t1 > t2 then t1, t2 = t2, t1 end
			tmin, tmax = math.max(tmin, t1), math.min(tmax, t2)
			if tmin > tmax then return nil end
		end
	end
	return tmin, tmax
end

buildHop = function(node, d)
	local P = node.pos
	local len = math.min(reachLimit(P) + 2, 30)
	if len < 3 then return nil end
	local o = P + V3(0, BODY_OFF, 0)
	local center = o + d * (len / 2)
	local boxCf = CFrame.lookAt(center, center + d)

	local zones = {}
	for _, part in ipairs(Workspace:GetPartBoundsInBox(boxCf, V3(6, 7, len), hazardOverlap)) do
		if part.ClassName ~= "Terrain" and hazardPart(part) then
			local tin, tout = zoneAlong(part, o, d)
			if tin and tout > 0 then zones[#zones + 1] = { tin, tout } end
		end
	end
	if #zones == 0 then return nil end
	table.sort(zones, function(a, b) return a[1] < b[1] end)
	local S0, S1 = zones[1][1], zones[1][2]
	for i = 2, #zones do -- hazards closer together than a body can't be landed between: one big zone
		if zones[i][1] <= S1 + 1.2 then S1 = math.max(S1, zones[i][2]) else break end
	end

	local function groundAt(q)
		local hit = raycast(V3(q.X, P.Y + 2.2, q.Z), V3(0, -5.5, 0))
		if hit and hit.Normal.Y >= COS_SLOPE and not isHazardHit(hit) and math.abs(hit.Position.Y - P.Y) <= CONFIG.StepUp then
			return hit
		end
	end

	-- takeoff: floor right before the zone, or (a gap comes first) the ledge before that gap.
	-- If we already stand inside the zone the step backs off first (retreat logic).
	local T, edge = P, nil
	local Th = groundAt(P + d * (S0 - 0.25))
	if Th and not hazardOriented(Th.Position, d) then
		T = Th.Position
		if T ~= P and not pathClear(P, T, RADIUS) then return nil end
	else
		local Te, ed = findTakeoff(P, d, math.min(math.max(S0, 1.5), CONFIG.EdgeScan + 3))
		if Te then T, edge = Te, ed end
	end

	for _, extra in ipairs({ 0.3, 0.7, 1.2, 1.8 }) do
		local hit = groundAt(P + d * (S1 + extra))
		if hit and hit.Normal.Y >= COS_LAND and not hazardOriented(hit.Position, d) then
			local L = hit.Position
			local need = flatDist(L, T)
			local t = flightTime(L.Y - T.Y)
			if t and need <= S.speed * t * CONFIG.ReachSafety - 0.2 and arcClear(T, L, t, true, 8) then
				return {
					kind = "jump", vault = true, pos = L, inst = hit.Instance, takeoff = T,
					cost = flatDist(P, T) + need + CONFIG.JumpPenalty + 1, runup = pickRunup(node, T, d),
				}
			end
			-- too far for an ordinary jump: late jump from the ledge (longer reach)
			if edge and CONFIG.MaxLateJump > 0 and L.Y - edge.Y <= CONFIG.StepUp then
				local need2 = flatDist(L, edge)
				local tt, tau = fitReach(L.Y - edge.Y, need2, true)
				if tt and tau > 0 and arcClear(edge, L, tt, true, 8, nil, tau) then
					return {
						kind = "jump", vault = true, pos = L, inst = hit.Instance, takeoff = edge, late = tau,
						cost = flatDist(P, edge) + need2 + CONFIG.JumpPenalty + 1, runup = pickRunup(node, edge, d),
					}
				end
			end
		end
	end
	return nil
end
end --[[blk]]

local function expandHops(node, out, dirs)
	if S.vyReal < 10 or S.speed < 1 then return end
	local gd = flat(goalPos - node.pos)
	for _, d in ipairs(dirs) do
		if vaultExpansions >= CONFIG.MaxVaultExpansions then return end
		if gd.Magnitude < 1 or d:Dot(gd.Unit) > -0.05 then
			vaultExpansions += 1
			local e = buildHop(node, d)
			if e then out[#out + 1] = e end
			checkYield()
		end
	end
end

-- returns pos, inst, cost, isDrop   |   nil, reason ("gap" / "block")
local function tryWalk1(a, tx, tz)
	local ay = a.Y
	local su = CONFIG.StepUp
	local down = math.min(su + 0.3 + CONFIG.MaxFall, ay + su + 0.3 - (Workspace.FallenPartsDestroyHeight + 15))
	if down <= su then return nil, "gap" end
	local r = raycast(V3(tx, ay + su + 0.3, tz), V3(0, -down, 0))
	if r and r.Normal.Y >= COS_SLOPE then
		if isHazardHit(r) then
			hazRejects += 1
			lastHazardPart = r.Instance
			return nil, "hazard" -- lava / kill brick = not floor, hop over it
		end
		local slip = isSlipperyHit(r)
		if slip and CONFIG.ForbidSlippery then return nil, "gap" end
		local b = r.Position
		if b.Y < Workspace.FallenPartsDestroyHeight + 15 then return nil, "gap" end
		local dy = b.Y - ay
		local q, ok, drop = b, true, false
		if dy > su then
			ok = rampOK(a, b)
		elseif dy < -su then
			q = V3(b.X, ay, b.Z) -- walk off the ledge, then fall
			drop = true
		end
		local clearN = ok and pathClear(a, q, RADIUS)
		local narrow = false
		if ok and not clearN and CONFIG.NarrowSqueeze and CONFIG.FakeShiftlock then
			clearN = pathClear(a, q, narrowR()) -- too tight face-on: can we pass sideways?
			narrow = clearN
		end
		if ok and clearN then
			if hazardAtBody(b) or hazardAtBody((a + b) / 2) then
				hazRejects += 1
				return nil, "hazard" -- the step is fine except a hazard sits in it: let the hop logic try to clear it
			end
			local cost = flatDist(a, b) + (drop and (2 + math.abs(dy) * 0.05) or math.abs(dy) * 0.3)
			if slip then
				cost += CONFIG.SlipPenalty
				if CONFIG.SlipEdgePenalty > 0 then cost += slipEdgePenalty(b) end
			end
			return b, r.Instance, cost + (narrow and 1.5 or 0), drop, narrow
		end
	end
	-- steep ramp probe (rise bigger than a step)
	local top = ay + math.min(CELL * math.tan(math.rad(CONFIG.MaxSlopeDeg)), 8)
	local r2 = raycast(V3(tx, top, tz), V3(0, -(top - ay - su), 0))
	if r2 and r2.Normal.Y >= COS_SLOPE then
		local b = r2.Position
		if rampOK(a, b) and pathClear(a, b, RADIUS * 0.5) and not isHazardHit(r2) and not hazardAtBody(b) then
			return b, r2.Instance, flatDist(a, b) + (b.Y - ay) * 0.5, false
		end
	end
	return nil, (r == nil) and "gap" or "block"
end

-- A 1-2 stud wide walkway can fall between the cells of the 2-stud lattice. When a cell is "gap", also try cells nudged
-- sideways so the strip is found (we then slide along it facing the wall, thin side across).
local function tryWalk(a, tx, tz)
	local b, inst, cost, drop, narrow = tryWalk1(a, tx, tz)
	if b or inst ~= "gap" or not CONFIG.NarrowSnap then return b, inst, cost, drop, narrow end
	local dx, dz = tx - a.X, tz - a.Z
	local l = math.sqrt(dx * dx + dz * dz)
	if l < 0.1 then return b, inst, cost, drop, narrow end
	local px, pz = -dz / l, dx / l
	for _, off in ipairs({ 0.8, -0.8 }) do
		local b2, i2, c2, d2, n2 = tryWalk1(a, tx + px * off, tz + pz * off)
		if b2 then return b2, i2, c2, d2, n2 end
	end
	return b, inst, cost, drop, narrow
end

local function expandWalk(node, out)
	local p = node.pos
	local gaps, blocks = 0, 0
	local bdirs, hdirs = {}, {}
	for i = 1, 8 do
		local o = OFFSETS[i]
		local b, inst, cost, drop, narrow = tryWalk(p, p.X + o[1] * CELL, p.Z + o[2] * CELL)
		if b then
			out[#out + 1] = { kind = "walk", pos = b, inst = inst, cost = cost, drop = drop, from = p, narrow = narrow }
			if drop then gaps += 1 end
		elseif inst == "gap" then
			gaps += 1
		elseif inst == "hazard" then
			gaps += 1
			hdirs[#hdirs + 1] = V3(o[1], 0, o[2]).Unit
		else
			blocks += 1
			bdirs[#bdirs + 1] = V3(o[1], 0, o[2]).Unit
		end
	end
	return gaps, blocks, bdirs, hdirs
end

---------------------------------------------------------------- A*
local function keyOf(p)
	local qx = math.floor(p.X + 0.5) + 100000
	local qz = math.floor(p.Z + 0.5) + 100000
	local qy = math.floor(p.Y * 0.5 + 0.5) + 2000
	return (qx * 200003 + qz) * 4001 + qy
end

local function heapPush(h, item, pri)
	local n = h.n + 1
	h.n = n
	local items, pris = h.items, h.pris
	local i = n
	while i > 1 do
		local parent = i // 2
		if pris[parent] <= pri then break end
		items[i], pris[i] = items[parent], pris[parent]
		i = parent
	end
	items[i], pris[i] = item, pri
end

local function heapPop(h)
	local items, pris, n = h.items, h.pris, h.n
	local top = items[1]
	local item, pri = items[n], pris[n]
	items[n], pris[n] = nil, nil
	n -= 1
	h.n = n
	if n > 0 then
		local i = 1
		while true do
			local c = i * 2
			if c > n then break end
			if c < n and pris[c + 1] < pris[c] then c += 1 end
			if pris[c] >= pri then break end
			items[i], pris[i] = items[c], pris[c]
			i = c
		end
		items[i], pris[i] = item, pri
	end
	return top
end

local function findPath(startPos, startInst, goal, weight)
	local nodes = {}
	local open = { n = 0, items = {}, pris = {} }
	local W = weight or CONFIG.HeuristicWeight
	jumpExpansions = 0
	fallExpansions = 0
	vaultExpansions = 0
	S.slideN = 0
	S.rungs = {}

	local function getNode(pos, inst)
		local k = keyOf(pos)
		local n = nodes[k]
		if not n then
			n = { pos = pos, inst = inst, g = math.huge, h = heur(pos, goal) }
			nodes[k] = n
		end
		return n
	end

	faceCache = {}
	climbChecks = 0
	climbSeen = {}
	bodyCache = {}
	hazRejects = 0
	lastHazardPart = nil
	local s = getNode(startPos, startInst)
	s.g = 0
	s.landing = true
	s.maxH = s.h
	heapPush(open, s, s.h * W)
	local best, count = s, 0
	local bestScore = s.h
	local out = {}

	while open.n > 0 do
		local n = heapPop(open)
		if not n.closed then
			n.closed = true
			count += 1
			if flatDist(n.pos, goal) <= CONFIG.GoalTolerance and math.abs(n.pos.Y - goal.Y) <= 4 then
				return n, true, count
			end
			-- fallback target for unreachable goals: closest node whose route never moved AWAY from the goal
			if n.maxH <= s.h + CONFIG.BacktrackTol then
				local sc = n.h + CONFIG.FallbackPathWeight * n.g
				if sc < bestScore then best, bestScore = n, sc end
			end
			if count >= CONFIG.MaxNodes then break end

			table.clear(out)
			local gaps, blocks, bdirs, hdirs = expandWalk(n, out)
			if n.landing or gaps >= 2 then
				expandJumps(n, out, false)
			elseif gaps + blocks >= 3 then
				expandJumps(n, out, true)
			end
			if (n.landing or gaps >= 2) and goal.Y < n.pos.Y - 4 then
				expandFalls(n, out) -- target is lower: consider dropping off ledges (reach counted per sample)
			end
			if CONFIG.ClimbEnabled then
				expandClimbs(n, out)
			end
			if CONFIG.VaultEnabled and #bdirs > 0 then
				expandVaults(n, out, bdirs)
			end
			if CONFIG.VaultEnabled and #hdirs > 0 then
				expandHops(n, out, hdirs)
			end

			for _, e in ipairs(out) do
				local m = getNode(e.pos, e.inst)
				if not m.closed then
					local ng = n.g + e.cost
					if ng < m.g then
						m.g, m.parent, m.edge = ng, n, e
						m.pos, m.inst = e.pos, e.inst
						m.landing = (e.kind ~= "walk")
						m.h = heur(m.pos, goal)
						m.maxH = math.max(n.maxH, m.h)
						heapPush(open, m, ng + m.h * W)
					end
				end
			end
		end
		checkYield()
	end
	if s.h - best.h < 2 then best = s end -- no real forward progress possible: stay put
	return best, false, count
end

local function simplify(steps, startPos)
	local out = {}
	local prev = startPos
	for i, st in ipairs(steps) do
		local nxt = steps[i + 1]
		local drop = false
		if st.kind == "walk" and nxt and nxt.kind == "walk" and st.narrow == nxt.narrow then
			local d1, d2 = flat(st.pos - prev), flat(nxt.pos - st.pos)
			if d1.Magnitude > 0.01 and d2.Magnitude > 0.01
				and d1.Unit:Dot(d2.Unit) > 0.995
				and math.abs((st.pos.Y - prev.Y) / d1.Magnitude - (nxt.pos.Y - st.pos.Y) / d2.Magnitude) < 0.15 then
				drop = true -- collinear, skip waypoint (keeps `prev` as last kept point)
			end
		end
		if not drop then
			out[#out + 1] = st
			prev = (st.kind == "jump") and st.land or (st.kind == "climb" and st.exit or st.pos)
		end
	end
	return out
end

local function buildSteps(endNode, goal, complete, startPos)
	local chain = {}
	local n = endNode
	while n do table.insert(chain, 1, n); n = n.parent end
	local steps = {}
	for i = 2, #chain do
		local e = chain[i].edge
		if e.kind == "climb" then
			local fd = flat((e.cpos or objPos(e.truss)) - e.from)
			steps[#steps + 1] = {
				kind = "climb", truss = e.truss, exit = e.pos, topY = e.topY, botY = e.botY, up = e.up,
				custom = e.custom, reach = e.reach, cpos = e.cpos,
				dir = fd.Magnitude > 0.01 and fd.Unit or V3(0, 0, 1),
			}
		elseif e.kind == "jump" then
			local dvia = flat((e.via or e.pos) - e.takeoff)
			local fz = flat(e.pos - e.takeoff)
			local d = e.backout and fz or dvia
			steps[#steps + 1] = {
				kind = "jump", takeoff = e.takeoff, land = e.pos,
				dir = d.Magnitude > 0.01 and d.Unit or V3(0, 0, 1),
				lip = (e.pos.Y - e.takeoff.Y) > CONFIG.StepUp, vault = e.vault, runup = e.runup, via = e.via, late = e.late, narrow = e.narrow or e.ext, ext = e.ext, edgePt = e.edgePt,
				inset = e.inset, face = (fz.Magnitude > 0.01) and fz.Unit or nil,
				backout = e.backout, moveDir = (dvia.Magnitude > 0.01) and dvia.Unit or nil,
			}
		elseif e.drop then
			-- walk off a ledge and fall (any depth): handled like a jump with no jump, steered to the landing
			local fd = flat(e.pos - e.from)
			steps[#steps + 1] = {
				kind = "jump", fall = true, takeoff = e.from, land = e.pos,
				dir = fd.Magnitude > 0.01 and fd.Unit or V3(0, 0, 1), lip = false,
			}
		else
			steps[#steps + 1] = { kind = "walk", pos = e.pos, narrow = e.narrow }
		end
	end
	if complete then steps[#steps + 1] = { kind = "walk", pos = goal } end
	return simplify(steps, startPos)
end

local function drawPath(steps)
	visuals:ClearAllChildren()
	if not CONFIG.ShowPath then return end
	for i, s in ipairs(steps) do
		if s.kind == "walk" then
			local last = i == #steps
			marker(s.pos, last and WHITE or GREEN, last and 1.4 or 0.7)
		elseif s.kind == "climb" then
			marker(s.exit, Color3.fromRGB(190, 120, 255), 1.1)
		elseif s.fall then
			marker(s.land, Color3.fromRGB(80, 170, 255), 1.1)
		else
			marker(s.takeoff, YELLOW, 0.9)
			marker(s.land, RED, 1.1)
		end
	end
end

