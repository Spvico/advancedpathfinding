local function doJump(hum)
	hum.Jump = true
	pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
end

local function stop(msg, color)
	searchId += 1
	retryId += 1
	brakeUntil = 0
	follow = nil
	visuals:ClearAllChildren()
	local _, hum = getChar()
	if hum then hum:Move(Vector3.zero, false) end
	if msg then notify(msg, color) end
end

local startSearch

local function finish(f)
	follow = nil
	local _, hum, root = getChar()
	if hum then hum:Move(Vector3.zero, false) end
	if hum and root and CONFIG.IceSupport then
		local r = raycast(root.Position, V3(0, -(S.rootH + 3), 0))
		if r and isSlipperyHit(r) then brakeUntil = os.clock() + 1.5 end -- ice: counter-steer to stop
	end
	task.delay(1.2, function() if not follow then visuals:ClearAllChildren() end end)
	retryId += 1
	local rid = retryId
	local goal = f.goal

	if f.partial then
		-- reached the closest point: keep trying the real target (things may move / open up)
		notify("Closest point - retrying target...", ORANGE)
		task.spawn(function()
			task.wait(0.4)
			for _ = 1, CONFIG.RetryAttempts do
				if rid ~= retryId or not active or follow then return end
				if searchingId == 0 then startSearch(goal, { retry = true, quiet = true }) end
				local t0 = os.clock()
				while os.clock() - t0 < CONFIG.RetryInterval do
					task.wait(0.1)
					if rid ~= retryId or not active or follow then return end
				end
			end
			if rid == retryId and active and not follow then notify("Target unreachable", RED) end
		end)
	else
		notify("Arrived", GREEN)
		if (f.holds or 0) < 4 then
			-- brief hold: if something pushes us off the spot, walk back
			task.spawn(function()
				local t0 = os.clock()
				while os.clock() - t0 < CONFIG.HoldSeconds do
					task.wait(0.2)
					if rid ~= retryId or not active or follow then return end
					local _, h, root = getChar()
					if not h or userSteering() then return end
					if flatDist(root.Position, goal) > CONFIG.HoldDrift then
						startSearch(goal, { quiet = true, retry = true, holds = (f.holds or 0) + 1 })
						return
					end
				end
			end)
		end
	end
end

-- free = deviation (pushed off route) rather than a failure, so it doesn't burn the failure budget
local function replan(f, reason, free)
	if free then
		if f.reroutes >= CONFIG.MaxReroutes then
			stop("Too many deviations", RED)
		else
			startSearch(f.goal, { replans = f.replans, reroutes = f.reroutes + 1, quiet = true, holds = f.holds, hz = f.hz })
		end
	elseif f.replans >= CONFIG.MaxReplans then
		stop("Path failed (" .. reason .. ")", RED)
	else
		startSearch(f.goal, { replans = f.replans + 1, reroutes = f.reroutes, quiet = true, holds = f.holds, hz = f.hz })
	end
end

startSearch = function(goal, opts)
	opts = opts or {}
	searchId += 1
	local my = searchId
	searchingId = my
	follow = nil
	task.spawn(function()
		local function run()
			local _, hum, root = getChar()
			local waited = 0
			while hum and hum.FloorMaterial == Enum.Material.Air and waited < 3 do
				task.wait(0.1)
				waited += 0.1
				if my ~= searchId then return end
				_, hum, root = getChar()
			end
			if not hum then return end
			refreshFilter()
			readStats(hum, root)
			local g0 = raycast(root.Position, V3(0, -15, 0))
			local inst0 = g0 and g0.Instance
			local startPos = g0 and g0.Position or (root.Position - V3(0, S.rootH, 0))
			currentToken, goalPos, sliceStart = my, goal, os.clock()
			if not opts.quiet then notify("Pathfinding...", WHITE) end

			local ok, endNode, complete = pcall(findPath, startPos, inst0, goal)
			if my ~= searchId or not active then return end
			if not ok then
				if endNode ~= CANCEL then
					warn("[AdvancedPathfinder] " .. tostring(endNode))
					notify("Pathfinder error", RED)
				end
				return
			end

			if not complete then
				if endNode.parent == nil then
					if not opts.retry then
						if hazRejects > 0 then
							notify("Blocked by hazard" .. (lastHazardPart and (" (" .. lastHazardPart.Name .. ")") or "")
								.. " - no safe way over or around", RED)
						else
							notify("No path - staying put", RED)
						end
					end
					return
				end
				-- The first search is weighted toward the unreachable goal, so its route to the fallback
				-- point can wander. Re-search straight to that point with plain A* for a direct route.
				local fb = endNode.pos
				goalPos, sliceStart = fb, os.clock()
				local ok2, n2, c2 = pcall(findPath, startPos, inst0, fb, 1.0)
				if my ~= searchId or not active then return end
				if ok2 and c2 then endNode = n2 end
				-- safety: refuse routes that wander away from the goal
				local startH, worst, n = heur(startPos, goal), 0, endNode
				while n do
					worst = math.max(worst, heur(n.pos, goal))
					n = n.parent
				end
				if worst > startH + CONFIG.BacktrackTol + 2 then
					if not opts.retry then notify("No path - staying put", RED) end
					return
				end
				if not opts.retry then notify("No full route - going to closest point", ORANGE) end
			end

			local steps = buildSteps(endNode, goal, complete, startPos)
			if #steps == 0 then return end
			follow = {
				steps = steps, i = 1, prev = startPos, goal = goal, partial = not complete,
				replans = opts.replans or 0, reroutes = opts.reroutes or 0, holds = opts.holds or 0, hz = opts.hz or 0,
				lastPos = root.Position, lastT = os.clock(), stuck = 0,
			}
			drawPath(steps)
		end
		local ok, err = pcall(run)
		if not ok then warn("[AdvancedPathfinder] " .. tostring(err)) end
		if searchingId == my then searchingId = 0 end
	end)
end

-- Ice control. Roblox ice lets you keep sliding and barely lets you accelerate, so:
--  * we LEARN how hard the surface lets us accelerate (S.iceAccel, studs/s^2) from what actually happens
--  * pure pursuit: aim at a point ahead ON the route line, so sideways slide gets pulled back to the line
--  * speed plan: v = sqrt(vExit^2 + 2*a*dist) -> slow down just enough to make the corner / stop in time
--  * steer on velocity ERROR: pushing against our own slide is what actually brakes us
local function iceSteer(hum, root, f, step, fl, dist, last, speed, dt, feet)
	local v = root.AssemblyLinearVelocity
	local hv = V3(v.X, 0, v.Z)

	-- learn traction from the last command
	if f.iv and f.icmd and f.icmd.Magnitude > 0.5 and dt > 0 then
		local meas = (hv - f.iv):Dot(f.icmd.Unit) / math.max(dt, 1 / 120)
		if meas > 0.3 then
			S.iceAccel = math.clamp(S.iceAccel * 0.92 + (meas / math.min(f.icmd.Magnitude, 1)) * 0.08, 1.5, 80)
		end
	end
	f.iv = hv

	-- pure pursuit point on the segment prev -> waypoint
	local A, B = f.prev, step.pos
	local seg = V3(B.X - A.X, 0, B.Z - A.Z)
	local segLen = seg.Magnitude
	local sd = (segLen > 0.1) and seg / segLen or fl / dist
	local aim = fl / dist
	if segLen > 0.5 then
		local along = math.clamp((feet.X - A.X) * sd.X + (feet.Z - A.Z) * sd.Z, 0, segLen)
		local tp = math.min(segLen, along + math.clamp(speed * 0.2 + 1.5, 1.5, 4.5))
		local to2 = V3(A.X + sd.X * tp - feet.X, 0, A.Z + sd.Z * tp - feet.Z)
		if to2.Magnitude > 0.05 then aim = to2.Unit end
	end

	-- how fast may we arrive at this waypoint (corner / stop), given real traction
	local vExit = 0
	if not last then
		local nxt = f.steps[f.i + 1]
		if nxt and nxt.kind == "walk" then
			local nd = V3(nxt.pos.X - B.X, 0, nxt.pos.Z - B.Z)
			vExit = (nd.Magnitude > 0.1) and speed * math.clamp(sd:Dot(nd.Unit), 0.25, 1) or speed
		elseif nxt and nxt.kind == "jump" then
			vExit = speed * math.clamp(sd:Dot(nxt.dir), 0.4, 1)  -- keep momentum into the takeoff
		else
			vExit = speed * 0.5
		end
	end
	local vWant = math.min(speed, math.sqrt(vExit * vExit + 2 * S.iceAccel * math.max(dist - 0.3, 0)))

	local err = (aim * vWant - hv) / math.max(speed, 1)
	local mv = (err.Magnitude > 1) and err.Unit or err
	f.icmd = mv
	hum:Move(mv, false)
end

-- run-up to a takeoff point on ice: arrive at full speed with the velocity already pointing along the jump
local function iceRunSteer(hum, root, toT, d, dir, speed)
	local v = root.AssemblyLinearVelocity
	local k = math.clamp(d / 3, 0, 1)
	local aim = ((d > 0.05) and (toT / d) * k or Vector3.zero) + dir * (1 - k)
	if aim.Magnitude < 0.01 then aim = dir end
	local err = (aim.Unit * speed - V3(v.X, 0, v.Z)) / math.max(speed, 1)
	hum:Move((err.Magnitude > 1) and err.Unit or err, false)
end

-- is the ground under us slippery? (cached, 10 Hz)
local function groundSlip(f, root)
	local now = os.clock()
	if now - (f.slipT or 0) > 0.1 then
		f.slipT = now
		local r = raycast(root.Position, V3(0, -(S.rootH + 3), 0))
		f.slip = r ~= nil and isSlipperyHit(r)
	end
	return f.slip
end

local function onStep(dt)
	local f = follow
	if not f and active and brakeUntil > os.clock() then
		-- arrived on ice: push against our own velocity so we don't slide off the platform
		local _, hum, root = getChar()
		if hum and not userSteering() then
			local v = root.AssemblyLinearVelocity
			local hv = V3(v.X, 0, v.Z)
			if hv.Magnitude < 1.2 then
				brakeUntil = 0
			else
				local mv = -hv / math.max(hum.WalkSpeed, 1)
				hum:Move(mv.Magnitude > 1 and mv.Unit or mv, false)
			end
		else
			brakeUntil = 0
		end
		return
	end
	if not f or not active then return end
	local _, hum, root = getChar()
	if not hum then stop() return end
	if userSteering() then stop("Manual control", ORANGE) return end

	local pos = root.Position
	local speed = hum.WalkSpeed
	local rootH = S.rootH
	local feet = pos - V3(0, rootH, 0)
	local grounded = hum.FloorMaterial ~= Enum.Material.Air
	local step = f.steps[f.i]

	-- pushed ahead (conveyor etc.): if we're already at a later waypoint, skip to it
	if step and step.kind == "walk" then
		local reachedJ
		for j = f.i + 1, math.min(f.i + 4, #f.steps) do
			local sj = f.steps[j]
			if sj.kind ~= "walk" then break end
			local tj = sj.pos - feet
			if math.sqrt(tj.X * tj.X + tj.Z * tj.Z) <= 1.3 and tj.Y < 3.5 and tj.Y > -4 then reachedJ = j end
		end
		if reachedJ then
			f.prev = f.steps[reachedJ].pos
			f.i = reachedJ + 1
			step = f.steps[f.i]
		end
	end

	local slip = CONFIG.IceSupport and grounded and groundSlip(f, root)

	-- walking waypoints (never stops between them = no momentum loss)
	while step and step.kind == "walk" do
		local last = f.i == #f.steps
		local to = step.pos - feet
		local fl = V3(to.X, 0, to.Z)
		local dist = fl.Magnitude
		local reach = (last and 0.9 or math.max(1.3, speed * dt * 1.6)) + (slip and (last and 0.3 or 0.8) or 0)
		local done = dist <= reach and to.Y < 3.5
		if not done and not last and dist < 4 then
			local seg = flat(step.pos - f.prev)
			if seg.Magnitude > 0.1 and fl:Dot(seg.Unit) < 0 then done = true end
		end
		if not done then
			if dist <= 0.05 then
				hum:Move(Vector3.zero, false)
			elseif slip then
				iceSteer(hum, root, f, step, fl, dist, last, speed, dt, feet)
			else
				hum:Move(fl / dist, false)
			end
			break
		end
		f.prev = step.pos
		f.i += 1
		step = f.steps[f.i]
	end
	if not step then finish(f) return end

	-- pushed off the route (conveyor, knockback, moving platform): re-plan from where we are now
	if step.kind == "walk" and grounded then
		local a, b = f.prev, step.pos
		local abx, abz = b.X - a.X, b.Z - a.Z
		local len2 = abx * abx + abz * abz
		local t = 1
		if len2 > 0.25 then
			t = math.clamp(((feet.X - a.X) * abx + (feet.Z - a.Z) * abz) / len2, 0, 1)
		end
		local dx, dz = feet.X - (a.X + abx * t), feet.Z - (a.Z + abz * t)
		if math.sqrt(dx * dx + dz * dz) > CONFIG.OffRoute then
			if slip then tempBlocked[cellKey(step.pos)] = os.clock() + 20 end -- slid away: skip this ice for a while
			replan(f, "pushed off route", true) return
		end
	end

	-- hazard guard: something deadly right ahead (moving kill part / undetected zone)? hold, then route around it
	if CONFIG.AvoidHazards and grounded and (step.kind == "walk" or step.phase ~= "air") then
		local tgt = (step.kind == "walk") and step.pos or (step.fall and step.land or step.takeoff)
		if tgt then
			local now0 = os.clock()
			if now0 - (f.hzT0 or 0) > 0.05 then
				f.hzT0 = now0
				f.hzAhead = nil
				local dv = V3(tgt.X - feet.X, 0, tgt.Z - feet.Z)
				local dl = dv.Magnitude
				if dl > 0.3 then
					local ahead = feet + (dv / dl) * math.min(dl, math.max(1.5, speed * 0.3))
					if hazardBox(CFrame.new(ahead.X, ahead.Y + 2.9, ahead.Z), V3(1.6, 4.6, 1.6)) then f.hzAhead = ahead end
				end
			end
			if f.hzAhead then
				hum:Move(Vector3.zero, false)
				f.hzWait = f.hzWait or os.clock()
				f.lastT, f.lastPos = os.clock(), pos
				if os.clock() - f.hzWait > 1.2 then
					tempBlocked[cellKey(f.hzAhead)] = os.clock() + 4
					f.hzWait, f.hzAhead = nil, nil
					f.hz = (f.hz or 0) + 1
					if f.hz >= 4 then stop("Hazard in the way - stopped", RED) return end
					replan(f, "hazard ahead", true)
				end
				return
			end
			f.hzWait = nil
		end
	end

	if step.kind == "climb" then
		local truss, E = step.truss, step.exit
		if not truss or not truss.Parent then replan(f, "truss gone") return end
		if not step.phase then step.phase, step.t0 = "approach", os.clock() end
		local tc = truss.Position
		local into = V3(tc.X - feet.X, 0, tc.Z - feet.Z)
		local il = into.Magnitude
		local intoDir = (il > 0.05) and into / il or step.dir
		local climbing = hum:GetState() == Enum.HumanoidStateType.Climbing
		local elapsed = os.clock() - step.t0

		if step.phase == "approach" then
			hum:Move(intoDir, false) -- walk into the truss, the Humanoid grabs it on contact
			if climbing then
				step.phase, step.t0 = "climb", os.clock()
			elseif elapsed > 4 then
				replan(f, "couldn't reach truss") return
			end
		else
			local toE = V3(E.X - feet.X, 0, E.Z - feet.Z)
			local tl = toE.Magnitude
			local toEDir = (tl > 0.05) and toE / tl or intoDir
			local mv
			if step.up then
				-- push into the truss to climb up; near the top head for the ledge
				mv = (feet.Y < step.topY - 1.2) and intoDir or toEDir
			else
				mv = (climbing and feet.Y > E.Y + 1.5) and -intoDir or toEDir
			end
			hum:Move(mv, false)
			if grounded and not climbing and elapsed > 0.3 and math.abs(feet.Y - E.Y) <= 2 and tl <= 6 then
				f.prev = E
				f.i += 1
			elseif elapsed > 15 or (grounded and not climbing and elapsed > 1.2 and math.abs(feet.Y - E.Y) > 3) then
				replan(f, "lost the truss") return
			end
		end
	elseif step.kind == "jump" then
		local T, L = step.takeoff, step.land
		if not step.phase then step.phase, step.t0 = "run", os.clock() end

		if step.phase == "run" and step.fall then
			-- walk off the ledge (no jump), then the air phase steers us onto the landing point
			local toL = V3(L.X - feet.X, 0, L.Z - feet.Z)
			local d = toL.Magnitude
			hum:Move((d > 0.05) and toL / d or step.dir, false)
			if not grounded then
				step.phase, step.t0, step.left, step.tries = "air", os.clock(), true, 1
			elseif d <= 1.3 and math.abs(feet.Y - L.Y) < 2.5 then
				f.prev = L
				f.i += 1
			elseif os.clock() - step.t0 > 8 then
				replan(f, "fall run-up timeout") return
			end
		elseif step.phase == "run" then
			-- keep running at full speed, fire the jump WHILE moving
			local toT = V3(T.X - feet.X, 0, T.Z - feet.Z)
			local d = toT.Magnitude
			local along = toT:Dot(step.dir)
			local retreat = false
			if step.vault and not step.ready then
				if along >= (step.runup or 1.4) - 0.6 then step.ready = true else retreat = true end
			end
			if retreat then
				local ru = step.runup or 1.4
				local R = V3(T.X - step.dir.X * ru - feet.X, 0, T.Z - step.dir.Z * ru - feet.Z)
				hum:Move((R.Magnitude > 0.05) and R.Unit or Vector3.zero, false)
			elseif slip then
				iceRunSteer(hum, root, toT, d, step.dir, speed)
			else
				hum:Move((d > 0.6) and (toT / d) or step.dir, false)
			end
			local rv = root.AssemblyLinearVelocity
			local hs = slip and math.sqrt(rv.X * rv.X + rv.Z * rv.Z) or speed
			if not retreat and grounded and along <= math.max(0.2, hs * dt * 1.25) then
				-- re-check with the REAL position: if we got shoved off the takeoff line, don't jump short
				local tNow = flightTime(L.Y - feet.Y)
				if not tNow or flatDist(feet, L) > speed * tNow * 0.98 then
					replan(f, "off the takeoff line", true) return
				end
				doJump(hum)
				step.phase, step.t0, step.left, step.tries = "air", os.clock(), false, 1
			elseif os.clock() - step.t0 > 8 then
				replan(f, "run-up timeout") return
			end
		else
			local vy = root.AssemblyLinearVelocity.Y
			if not step.left and (not grounded or vy > 8) then step.left = true end
			if step.left and not step.fall and not step.calDone then
				-- calibrate: peak upward speed right after takeoff = this player's real jump velocity
				step.maxVy = math.max(step.maxVy or 0, vy)
				if os.clock() - step.t0 > 0.12 then
					step.calDone = true
					local cal = step.maxVy + Workspace.Gravity * dt
					local nom = S.vyNom or cal
					if cal > nom * 0.75 and cal < nom * 1.35 then
						S.vyCal = cal
						S.calKey = hum.UseJumpPower and ("p" .. hum.JumpPower) or ("h" .. hum.JumpHeight)
					end
				end
			end
			local elapsed = os.clock() - step.t0

			if not step.left then
				hum:Move(step.dir, false)
				if elapsed > 0.35 then
					if step.tries >= 3 then replan(f, "jump failed") return end
					doJump(hum)
					step.tries += 1
					step.t0 = os.clock()
				end
			else
				-- exact landing: distance left / time left -> throttle, every frame
				local g = Workspace.Gravity
				local h = (L.Y + rootH) - pos.Y
				local disc = vy * vy - 2 * g * h
				local t = (disc >= 0) and (vy + math.sqrt(disc)) / g or math.max(vy / g, 0)
				local rem = V3(L.X - pos.X, 0, L.Z - pos.Z)
				local rd = rem.Magnitude
				local throttle
				if rd < 0.12 then
					throttle = 0
				elseif t > 0.03 then
					throttle = math.clamp(rd / t / math.max(speed, 0.1), 0, 1)
				else
					throttle = 1
				end
				if step.lip and feet.Y < L.Y - 0.3 then throttle = math.max(throttle, 0.6) end
				local mv = (rd > 0.05) and (rem / rd) or step.dir
				hum:Move(mv * throttle, false)
				if CONFIG.VelocityAssist then
					local v = mv * throttle * speed
					root.AssemblyLinearVelocity = V3(v.X, vy, v.Z)
				end

				if grounded and vy < 5 and elapsed > 0.12 then
					if flatDist(feet, L) > 3.5 then replan(f, "missed landing") return end
					f.prev = L
					f.i += 1
				elseif elapsed > 6 + 1.5 * math.sqrt(2 * math.max(0, T.Y - L.Y) / g) then
					replan(f, "air timeout") return
				end
			end
		end
	end

	-- stuck detection
	local now = os.clock()
	if now - f.lastT > 1.25 then
		local inAir = (step.kind == "jump" and step.phase == "air") or (step.kind == "climb" and step.phase == "climb")
		if grounded and not inAir and flatDist(pos, f.lastPos) < 0.7 then
			f.stuck += 1
			if f.stuck == 1 then
				doJump(hum)
			else
				if slip and step.kind == "walk" then tempBlocked[cellKey(step.pos)] = os.clock() + 30 end
				replan(f, "stuck") return
			end
		else
			f.stuck = 0
		end
		f.lastPos, f.lastT = pos, now
	end
end

---------------------------------------------------------------- world tap
local function pointer(input)
	if input.UserInputType == Enum.UserInputType.Touch then
		return Vector2.new(input.Position.X, input.Position.Y)
	end
	return UserInputService:GetMouseLocation()
end

local function rayFrom(input)
	local cam = Workspace.CurrentCamera
	if input.UserInputType == Enum.UserInputType.Touch then
		return cam:ScreenPointToRay(input.Position.X, input.Position.Y)
	end
	local m = UserInputService:GetMouseLocation()
	return cam:ViewportPointToRay(m.X, m.Y)
end

local function onWorldTap(ray)
	refreshFilter()
	local res = Workspace:Raycast(ray.Origin, ray.Direction * 2000, worldParams)
	if not res then notify("Nothing there", ORANGE) return end
	local ang = math.deg(math.acos(math.clamp(res.Normal.Y, -1, 1)))
	if ang > CONFIG.MaxSlopeDeg then
		notify(string.format("Too steep (%d°)", math.floor(ang + 0.5)), RED)
		return
	end
	if not CONFIG.AllowHazardGoal and isHazardHit(res) then
		notify("Kill brick - not going there", RED)
		return
	end
	retryId += 1
	startSearch(res.Position, {})
end

local pending = {}
connect(UserInputService.InputBegan, function(input, gp)
	if gp or not active then return end
	local t = input.UserInputType
	if t ~= Enum.UserInputType.Touch and t ~= Enum.UserInputType.MouseButton1 then return end
	local key = (t == Enum.UserInputType.Touch) and input or "mouse"
	pending[key] = { t = os.clock(), start = pointer(input), ray = rayFrom(input) }
end)
connect(UserInputService.InputEnded, function(input)
	local t = input.UserInputType
	local key = (t == Enum.UserInputType.Touch) and input or (t == Enum.UserInputType.MouseButton1 and "mouse")
	local p = key and pending[key]
	if not p then return end
	pending[key] = nil
	if active and os.clock() - p.t <= CONFIG.TapTime and (pointer(input) - p.start).Magnitude <= CONFIG.TapMove then
		onWorldTap(p.ray)
	end
end)

---------------------------------------------------------------- toggle button (tap / hold-drag)
local BIND = "AdvancedPathfinderStep"
local pressInput, pressT, dragMode, dragStartPtr, dragStartPos
local dragStartUDim

-- Pointer in the SAME space as AbsolutePosition (full-screen GUI space). Touch input.Position excludes the
-- top inset, GetMouseLocation includes it.
local function guiPointer(input)
	if input.UserInputType == Enum.UserInputType.Touch then
		local inset = GuiService:GetGuiInset()
		return Vector2.new(input.Position.X + inset.X, input.Position.Y + inset.Y)
	end
	return UserInputService:GetMouseLocation()
end

-- GUI hit boxes are rectangles even with UICorner, so the button's square corners would react to a press
-- that is clearly outside the visible circle. Only accept presses inside the circle.
local function insideCircle(input)
	local center = button.AbsolutePosition + button.AbsoluteSize / 2
	local r = button.AbsoluteSize.X / 2
	local d = (guiPointer(input) - center).Magnitude
	if d > r * 1.6 then return true end -- coordinates don't line up on this device: never lock the button
	return d <= r
end

local function refreshButton()
	button.BackgroundColor3 = dragMode and DRAG_COLOR or (active and ON_COLOR or OFF_COLOR)
	button.Size = dragMode and UDim2.fromOffset(68, 68) or UDim2.fromOffset(60, 60)
end

local function setActive(v)
	if v == active then return end
	active = v
	refreshButton()
	if v then
		RunService:BindToRenderStep(BIND, Enum.RenderPriority.Last.Value, onStep) -- after the default controls
		notify("Advanced Pathfinder ON - tap a spot", GREEN)
	else
		pcall(function() RunService:UnbindFromRenderStep(BIND) end)
		stop()
		notify("Advanced Pathfinder OFF", WHITE)
	end
end

local function isButtonInput(input)
	if not pressInput then return false end
	if input == pressInput then return true end
	return input.UserInputType == Enum.UserInputType.MouseButton1
		and pressInput.UserInputType == Enum.UserInputType.MouseButton1
end

connect(button.InputBegan, function(input)
	if pressInput then return end
	local t = input.UserInputType
	if t ~= Enum.UserInputType.Touch and t ~= Enum.UserInputType.MouseButton1 then return end
	if not insideCircle(input) then return end
	pressInput, pressT, dragMode = input, os.clock(), false
	local mine = input
	task.delay(CONFIG.HoldTime, function()
		if pressInput == mine and not dragMode then
			dragMode = true
			dragStartPtr = pointer(mine)
			dragStartUDim = button.Position -- drag RELATIVE to where it is: no absolute-position conversion, no jump
			refreshButton()
		end
	end)
end)

connect(UserInputService.InputChanged, function(input)
	if not (pressInput and dragMode) then return end
	local t = input.UserInputType
	if (t == Enum.UserInputType.Touch and input == pressInput)
		or (t == Enum.UserInputType.MouseMovement and pressInput.UserInputType == Enum.UserInputType.MouseButton1) then
		local dlt = pointer(pressInput) - dragStartPtr
		local W, H = gui.AbsoluteSize.X, gui.AbsoluteSize.Y
		local half = button.AbsoluteSize / 2
		local sx, sy = dragStartUDim.X, dragStartUDim.Y
		-- centre in pixels (button is anchored at its centre), clamped so it stays on screen
		local cx = math.clamp(sx.Scale * W + sx.Offset + dlt.X, half.X, math.max(half.X, W - half.X))
		local cy = math.clamp(sy.Scale * H + sy.Offset + dlt.Y, half.Y, math.max(half.Y, H - half.Y))
		button.Position = UDim2.new(sx.Scale, cx - sx.Scale * W, sy.Scale, cy - sy.Scale * H)
	end
end)

connect(UserInputService.InputEnded, function(input)
	if not isButtonInput(input) then return end
	local wasDrag, held = dragMode, os.clock() - pressT
	pressInput, dragMode = nil, false
	refreshButton()
	if not wasDrag and held < CONFIG.HoldTime then setActive(not active) end
end)

---------------------------------------------------------------- learning kill bricks
local touchCount, touchStart, charConns = {}, {}, {}
local lastHealth = 0
local lastDamageAt = 0

local function blame(part, w)
	if not part or not part.Parent then return end
	local ts = touchStart[part]
	if ts and os.clock() - ts > 1.5 then return end -- stood on it safely for a while: not the culprit
	local before = learned[part] or 0
	learned[part] = before + w
	hazardCache = setmetatable({}, { __mode = "k" })
	bodyCache = {}
	if before < 2 and learned[part] >= 2 then
		local sig = signature(part)
		if sig then sigHaz[sig] = (sigHaz[sig] or 0) + 1 end
		saved.haz[sigKey(part)] = true
		persist()
		notify("Learned hazard: " .. part.Name, ORANGE)
	end
end

local function setupLearning(char)
	for _, c in ipairs(charConns) do pcall(function() c:Disconnect() end) end
	table.clear(charConns)
	table.clear(touchCount)
	table.clear(touchStart)
	if not CONFIG.LearnHazards or not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
	if not hum then return end
	lastHealth = hum.Health
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") then
			charConns[#charConns + 1] = d.Touched:Connect(function(o)
				if o:IsDescendantOf(char) then return end
				touchCount[o] = (touchCount[o] or 0) + 1
				if touchCount[o] == 1 then touchStart[o] = os.clock() end
			end)
			charConns[#charConns + 1] = d.TouchEnded:Connect(function(o)
				local n = (touchCount[o] or 1) - 1
				if n <= 0 then
					touchCount[o], touchStart[o] = nil, nil
				else
					touchCount[o] = n
				end
			end)
		end
	end
	-- damage / death: blame what we JUST started touching (death counts double, damage needs 2 hits)
	charConns[#charConns + 1] = hum.HealthChanged:Connect(function(h)
		local dropped = lastHealth - h
		lastHealth = h
		if dropped < 0.5 then return end
		local now = os.clock()
		lastDamageAt = now
		for part, ts in pairs(touchStart) do
			if now - ts <= 0.6 then blame(part, h <= 0 and 2 or 1) end
		end
	end)
end

---------------------------------------------------------------- learning from other players
-- Players near us are watched: when one gets hurt / dies, the parts that appeared around their body in the
-- last half second (new contact, not the floor they were already on) are blamed. Two deaths = deadly.
local alive = true

-- Automatic correction of false alarms: if we have been touching a part believed deadly for 3 s and took no
-- damage since the contact began, it is NOT deadly (also fixes a wrongly blamed floor). Remembered per game.
local function clearFalseHazard(part)
	manual[part] = false
	learned[part] = nil
	local key = sigKey(part)
	saved.haz[key] = nil
	saved.safe[key] = true
	hazardCache = setmetatable({}, { __mode = "k" })
	bodyCache = {}
	persist()
	setMark(part, false)
end

task.spawn(function()
	while alive do
		task.wait(0.5)
		local now = os.clock()
		for part, ts in pairs(touchStart) do
			if now - ts > 3 and lastDamageAt < ts and part.Parent and hazardPart(part) then
				clearFalseHazard(part)
			end
		end
	end
end)

local othersHist = setmetatable({}, { __mode = "k" })
local otherConns = {}

local function isCharPart(p)
	local m = p.Parent
	for _ = 1, 3 do
		if not m then return false end
		if m:FindFirstChildOfClass("Humanoid") then return true end
		m = m.Parent
	end
	return false
end

local function bodySet(root)
	local set = {}
	for _, p in ipairs(Workspace:GetPartBoundsInBox(CFrame.new(root.Position), V3(2.6, 5.2, 2.6), hazardOverlap)) do
		if p.ClassName ~= "Terrain" and not isCharPart(p) then set[p] = true end
	end
	return set
end

local function trackOthers()
	while alive do
		task.wait(0.25)
		if CONFIG.LearnFromOthers and CONFIG.LearnHazards then
			local _, _, myRoot = getChar()
			if myRoot then
				local list = {}
				for _, pl in ipairs(Players:GetPlayers()) do
					local h = pl ~= player and pl.Character and pl.Character:FindFirstChildOfClass("Humanoid")
					local r = h and h.RootPart
					if h and r and h.Health > 0 then
						local d = (r.Position - myRoot.Position).Magnitude
						if d < 250 then list[#list + 1] = { h = h, r = r, d = d } end
					end
				end
				table.sort(list, function(a, b) return a.d < b.d end)
				for i = 1, math.min(6, #list) do
					local h, r = list[i].h, list[i].r
					local rec = othersHist[h]
					if not rec then
						rec = { ring = {}, hp = h.Health }
						othersHist[h] = rec
						otherConns[#otherConns + 1] = h.HealthChanged:Connect(function(hp)
							local dropped = rec.hp - hp
							rec.hp = hp
							if dropped < 0.5 or #rec.ring == 0 then return end
							local now = os.clock()
							local newest = rec.ring[#rec.ring].set
							local old
							for j = #rec.ring, 1, -1 do
								if now - rec.ring[j].t >= 0.5 then
									old = rec.ring[j].set
									break
								end
							end
							for part in pairs(newest) do
								if not (old and old[part]) then blame(part, hp <= 0 and 1 or 0.5) end
							end
						end)
					end
					local ring = rec.ring
					ring[#ring + 1] = { t = os.clock(), set = bodySet(r) }
					if #ring > 6 then table.remove(ring, 1) end
				end
			end
		end
	end
end
task.spawn(trackOthers)

