local function flat(v) return V3(v.X, 0, v.Z) end
local function flatDist(a, b)
	local dx, dz = a.X - b.X, a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

-- search heuristic: going down is nearly free (falling), going up costs full height
local function heur(p, g)
	local dx, dz = p.X - g.X, p.Z - g.Z
	local dy = g.Y - p.Y
	return math.sqrt(dx * dx + dz * dz) + (dy > 0 and dy or -dy * 0.05)
end

local function objPos(obj) -- position of a Part or a Model
	if obj:IsA("Model") then return obj:GetPivot().Position end
	return obj.Position
end

