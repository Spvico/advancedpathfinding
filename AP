local V3 = Vector3.new
local COS_SLOPE = math.cos(math.rad(CONFIG.MaxSlopeDeg))
local COS_LAND  = 0.5  -- landing / jump-target surfaces up to 60 degrees
local MID_H, HEAD_H = 2.6, 4.6
local RADIUS = CONFIG.AgentRadius
