local function raycast(o, d) return Workspace:Raycast(o, d, worldParams) end

local HAS_SPHERE = pcall(function() return Workspace.Spherecast end)
local function sweep(o, d, radius)
	if HAS_SPHERE then return Workspace:Spherecast(o, radius, d, worldParams) end
	return Workspace:Raycast(o, d, worldParams)
end

local function getChar()
	local c = player.Character
	if not c then return end
	local hum = c:FindFirstChildOfClass("Humanoid")
	local root = hum and hum.RootPart or c:FindFirstChild("HumanoidRootPart")
	if hum and root and hum.Health > 0 then return c, hum, root end
end

local function measureRootH(hum, root)
	if hum.FloorMaterial ~= Enum.Material.Air then
		local r = raycast(root.Position, V3(0, -10, 0))
		if r and r.Normal.Y > 0.97 then
			local d = root.Position.Y - r.Position.Y
			if d > 1 and d < 8 then rootHCache = d end
		end
	end
	if not rootHCache then
		rootHCache = root.Size.Y / 2 + hum.HipHeight + (hum.RigType == Enum.HumanoidRigType.R6 and 2 or 0)
	end
	return rootHCache
end

local function readStats(hum, root)
	local g = Workspace.Gravity
	local vy = hum.UseJumpPower and hum.JumpPower or math.sqrt(2 * g * hum.JumpHeight)
	S.vyNom = vy
	local jkey = hum.UseJumpPower and ("p" .. hum.JumpPower) or ("h" .. hum.JumpHeight)
	if S.calKey == jkey and S.vyCal then vy = S.vyCal end -- measured takeoff speed beats the nominal formula
	S.g = g
	S.vyReal = vy
	S.vy = vy * CONFIG.HeightSafety
	S.speed = hum.WalkSpeed
	S.rootH = measureRootH(hum, root)
	S.maxH = S.vy * S.vy / (2 * g)
end

-- time to come back down to (takeoff height + dh)
local function flightTime(dh)
	local disc = S.vy * S.vy - 2 * S.g * dh
	if disc < 0 then return nil end
	return (S.vy + math.sqrt(disc)) / S.g
end

local function checkYield()
	if os.clock() - sliceStart > CONFIG.TimeSlice then
		task.wait()
		sliceStart = os.clock()
		if currentToken ~= searchId then error(CANCEL, 0) end
	end
end

---------------------------------------------------------------- hazards (kill bricks)
-- There is no universal "kill brick" flag, so every part gets a score from many weak signals, and the
-- score is then CORRECTED by what actually happens (corrections beat guessing):
--   names (part + parents), tags, attributes, child scripts     strong words +3, weak words +1.6
--   TouchInterest +1, Fire child +1, red/orange colour +1.6, Neon +1, CrackedLava +1, repeated thin touch bars +0.8
--   CanTouch = false  -2 (can't fire Touched, so it can't be a touch-kill)
--   "safe / checkpoint / spawn / heal / deco" names always win
-- Corrections:
--   you die / get hurt right after touching something new = that part is blamed
--   other players dying / getting hurt where they just arrived = blamed (needs 2 deaths)
--   the same colour + material blamed twice = that look is deadly
--   a "hazard" you stand on / touch for 3 s without taking damage = false alarm, cleared automatically
-- Everything is automatic: no marking, no setup. Detected hazards get a red outline (ShowHazards).
local HAZ_STRONG = { "kill", "lava", "death", "deadly", "lethal", "damage", "dmg", "hurt", "harm", "hazard",
	"danger", "spike", "trap", "acid", "poison", "toxic", "fatal", "laser", "burn", "zap", "magma" }
local HAZ_WEAK = { "fire", "saw", "blade", "shock", "electr", "explo", "bomb", "dead", "pain", "oof", "thorn", "flame" }
local SAFE_WORDS = { "safe", "nokill", "antikill", "nodamage", "checkpoint", "spawn", "heal", "deco" }

local learned = env.__APLearned or setmetatable({}, { __mode = "k" }) -- part -> blame points
env.__APLearned = learned
local sigHaz = env.__APSigs or {}                                     -- colour+material -> #parts blamed
env.__APSigs = sigHaz
local manual = setmetatable({}, { __mode = "k" })                     -- part -> false = proven safe (auto-corrected)
local hazardCache = setmetatable({}, { __mode = "k" })
local tempBlocked = {}
local bodyCache = {}

